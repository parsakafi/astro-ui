---
/**
  * /components/ — full catalog: hero + per-category sections listing
  */
import {getCollection} from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import Button from "astro-ui/button";
import {categories} from "../../lib/components";

// Component metadata from the components content collection.
const entries = await getCollection("components");
const metas = entries.map((d) => d.data);
const byCategoryMeta = (id: string) => metas.filter((m) => m.category === id);
const stats = {
  components: metas.length,
  categories: categories.length,
  zeroJs: metas.filter((m) => !m.js).length,
};

const toc = [
  {id: "overview", label: "Overview"},
  ...categories.map((c) => ({id: `cat-${c.id}`, label: c.name})),
];

const guides = [
  {
    title: "Start with tokens",
    body: "Import tokens.css + base.css once — every component themes from the same custom properties.",
  },
  {
    title: "Zero JS first",
    body: `${stats.zeroJs} of ${stats.components} components need no script. Check the JS badge before wiring behavior.`,
  },
  {
    title: "Copy the usage block",
    body: "Every component page starts with a minimal, working usage snippet you can paste as-is.",
  },
];

// Quick-filter chips: All + per-category counts.
const filterChips = [
  {href: "#overview", label: `All ${stats.components}`},
  ...categories.map((c) => ({
    href: `#cat-${c.id}`,
    label: `${c.name} ${byCategoryMeta(c.id).length}`,
  })),
  {href: "#cat-forms", label: "Zero-JS"},
];
---

<DocsLayout title="Components" sidebar toc={toc}>
  <article class="docs-article">
    <section id="overview" class="docs-hero">
      <p class="docs-hero-kicker">Browse every component by category</p>
      <h1>Component Catalog</h1>
      <p>
        {stats.components} components across {stats.categories} categories.
        Browse by the job each one does, or jump straight into a dedicated
        docs page — every page carries overview, usage, live demos with
        code, the full API, FAQ, and its changelog.
      </p>
      <div class="docs-hero-actions">
        <Button href="/" variant="outline">Getting started</Button>
        <Button href="/docs/releases/" variant="ghost">Releases</Button>
      </div>
    </section>

    <nav class="docs-filter-bar" aria-label="Filter by category">
      {
        filterChips.map((chip) => (
          <a class="docs-filter-chip" href={chip.href}>{chip.label}</a>
        ))
      }
    </nav>

    <section class="docs-stats" aria-label="Catalog at a glance">
      <div class="docs-stat">
        <span class="docs-stat-value">{stats.components}</span>
        <span class="docs-stat-label">Total components</span>
      </div>
      <div class="docs-stat">
        <span class="docs-stat-value">{stats.categories}</span>
        <span class="docs-stat-label">Categories</span>
      </div>
      <div class="docs-stat">
        <span class="docs-stat-value">{stats.zeroJs}</span>
        <span class="docs-stat-label">Zero-JS components</span>
      </div>
      <div class="docs-stat">
        <span class="docs-stat-value">{metas.filter((m) => m.js).length}</span>
        <span class="docs-stat-label">With behavior</span>
      </div>
    </section>

    <section aria-label="Before you browse">
      <div class="docs-feature-grid">
        {
          guides.map((guide) => (
            <div class="docs-feature">
              <h3>{guide.title}</h3>
              <p>{guide.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    {
      categories.map((category) => {
        const items = byCategoryMeta(category.id);
        return (
          <section id={`cat-${category.id}`} class="docs-cat-section">
            <div class="docs-cat-head">
							<span class="docs-cat-icon" aria-hidden="true">
								{category.icon}
							</span>
              <div>
                <h2>{category.name}</h2>
                <p class="docs-cat-desc">{category.description}</p>
              </div>
              <span class="docs-side-count" style="margin-inline-start:auto">
								{items.length} components
							</span>
            </div>
            <div class="docs-cat-list">
              {items.map((component) => (
                <a class="docs-cat-link" href={`/components/${component.slug}/`}>
									<span>
										{component.name}
                    {component.js && (
                      <span class="docs-brand-version" style="margin-inline-start:.5rem">
												JS
											</span>
                    )}
                    {component.isNew && <span class="docs-new-badge">New</span>}
									</span>
                  <span class="arrow" aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          </section>
        );
      })
    }
  </article>
</DocsLayout>
