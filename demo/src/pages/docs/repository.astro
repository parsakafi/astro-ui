---
/**
 * /docs/repository/ — the monorepo behind this site: the astro-ui
 * package at the root plus the docs website in demo/, linked as npm
 * workspaces and orchestrated with Turborepo.
 */
import DocsLayout from "../../layouts/DocsLayout.astro";
import CodeBlock from "../../components/docs/CodeBlock.astro";

const toc = [
  {id: "layout", label: "Layout"},
  {id: "link", label: "Library ↔ demo link"},
  {id: "workflows", label: "Workflows"},
];
---

<DocsLayout title="Repository" description="Monorepo layout: the astro-ui package, the demo workspace, workspaces plus turbo." activePath="docs" toc={toc}>
  <article class="docs-article docs-prose">
    <section id="overview" class="docs-hero">
      <p class="docs-hero-kicker">Docs · Guide</p>
      <h1>Repository</h1>
      <p>
        One repo, two packages: the <code>astro-ui</code> component
        library lives at the root, this docs site lives in
        <code>demo/</code> — linked as npm workspaces, built and
        tested together with Turborepo.
      </p>
    </section>

    <section id="layout">
      <h2>Layout</h2>
      <CodeBlock
        code={`astro-ui/                   # repo root = the published package
  src/components/         # .astro sources, grouped by category
  src/styles/             # tokens.css (theming API) + base
  src/utils/              # cn(), toast()
  index.ts                # root entry (+ subpath export per component)
  tests/                  # contract + unit suites
  docs/                   # contributor docs (conventions, principles, ADRs)
  demo/                   # docs website workspace (Astro app)
    src/pages/            # guides, component catalog, blocks
    src/lib/registry/     # per-component docs metadata + snippets
    src/components/docs/  # live demo renderers
    src/content/          # generated docs (scripts/gen-docs.ts)
    tests/                # consistency + snippet suites
    scripts/              # gen-docs, render audits, id checks
  package.json            # workspaces: ["demo"], turbo pipelines
  turbo.json              # build/test/lint/check tasks
  .github/workflows/      # CI installs once, then runs every pipeline`}
        lang="text"
      />
    </section>

    <section id="link">
      <h2>Library ↔ demo link</h2>
      <p>
        The root <code>package.json</code> declares
        <code>"workspaces": ["demo"]</code>, so one install links
        everything and the demo always renders the working copy — no
        publish step while developing components. Pages that need
        library files (changelog, token source) resolve them through
        the shared <code>src/lib/ui-path.ts</code> helper, which finds
        the package via its workspace link or a standalone
        <code>node_modules</code> install alike.
      </p>
      <CodeBlock code={`npm install          # once, at the root\nnpm test             # library suites, then demo suites\nnpm run build        # docs site production build (turbo-cached)`} lang="bash"/>
    </section>

    <section id="workflows">
      <h2>Workflows</h2>
      <CodeBlock
        code={`npm run dev      # docs site with live components (turbo persistent)\nnpm test         # vitest (library) + turbo demo suites\nnpm run check    # astro check (library) + turbo demo check\nnpm run lint     # biome + eslint (library; demo has no lint config)\nnpm run build    # turbo demo build (css + check + astro build)`}
        lang="bash"
      />
      <p class="docs-muted-note">
        Turborepo caches task outputs, so repeated
        <code>build</code>/<code>test</code> runs only redo what
        changed. CI (see <code>.github/workflows/ci.yml</code>) runs
        install once, then lint, check, tests, and the docs build.
      </p>
    </section>
  </article>
</DocsLayout>
