---
/**
  * BlockDemo — renders the live markup for one block by id.
  *
  * The single source of truth for block previews: category pages,
  * detail pages, and the catalog all render through here so a block
  * looks identical everywhere. Blocks are REAL astro-ui components
  * composed per the recipe in lib/blocks.
  */
import {
  Button,
  Badge,
  Card,
  Chart,
  Tabs,
  Input,
  Checkbox,
  Separator,
  Switch,
  Accordion,
  Avatar,
  AvatarGroup,
  Bubble,
  BubbleContent,
  BubbleGroup,
  BubbleReactions,
  Breadcrumb,
  Tag,
  Empty,
  Kbd,
  Progress,
  Slider,
  Tooltip
} from "astro-ui";

interface Props {
  /** Block id from the registry (lib/blocks). */
  id: string;
  /** Prefix for form control ids so multiple instances can coexist. */
  idPrefix?: string;
}

const {id, idPrefix = "bd"} = Astro.props;
const fid = (name: string) => `${idPrefix}-${name}`;

const avatars = [
  {name: "Ada Lovelace"},
  {name: "Grace Hopper"},
  {name: "Alan Turing"},
