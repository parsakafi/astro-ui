---
/**
  * Demos — renders the live preview markup for each demo of a component.
  *
  * Previews are REAL astro-ui components authored here (single source of
  * truth for rendering); the code tab shows the matching snippet from the
  * registry via getDemoCode(). The CONTENT COLLECTION gates + orders which
  * demos appear (via the demoIds prop from frontmatter); Toast/Dialog
  * behavior is wired in one scoped script at the bottom.
  */
import DemoTabs from "./DemoTabs.astro";
import {codeToHtml} from "shiki";
import {bySlug} from "../../lib/components";
import {
  barRevenue,
  groupedDesktop,
  groupedMobile,
  lineThisWeek,
  lineLastWeek,
  forecast,
  strokeActual,
  strokeTarget,
  strokeStretch,
  visitors,
  signups,
  scatterA,
  scatterB,
  pageViews,
  ping,
} from "../../lib/chart-demo-data";
import {
  Accordion,
  AlertDialog,
  Alert,
  AspectRatio,
  Attachment,
  Autocomplete,
  Avatar,
  AvatarGroup,
  Badge,
  Breadcrumb,
  Bubble,
  BubbleContent,
  BubbleGroup,
  BubbleReactions,
  Button,
  ButtonGroup,
  ButtonGroupSeparator,
  ButtonGroupText,
  Card,
  Carousel,
  CarouselSlide,
  Chart,
  Checkbox,
  Clipboard,
  Collapsible,
  Combobox,
  Command,
  Dialog,
  Empty,
  Field,
  HoverCard,
  Input,
  Kbd,
  Label,
  Link,
  Pagination,
  Popover,
  Progress,
  Radio,
  Rating,
  ScrollArea,
  Select,
  Separator,
  Sheet,
  Skeleton,
  Slider,
  Spinner,
  Stepper,
  Switch,
  Table,
  Tag,
  Tabs,
  Textarea,
  Toaster,
  Toggle,
  ToggleGroup,
  Tooltip,
} from "astro-ui";
import BlockDemo from "./BlockDemo.astro";

interface Props {
  /** Component slug — keys the per-component demo switch below. */
  slug: string;
  /** Demo ids from the docs collection frontmatter (order + gating). */
  demoIds: string[];
}

const {slug, demoIds} = Astro.props;
const component = bySlug(slug);
// Collection referenced an unknown slug — the page gates on demoIds
// being non-empty, so this only fires on a data bug.
if (!component) throw new Error(`Demos: unknown component slug "${slug}"`);

// Shiki-highlight every snippet used by this component up front.
const codeCache = new Map<string, string>();
for (const id of demoIds) {
  const demo = component.demos.find((d) => d.id === id);
  if (!demo) continue; // unknown id in frontmatter — gated out, nothing to highlight
  codeCache.set(
    demo.id,
    await codeToHtml(demo.code.trim(), {
      lang: "astro",
      themes: {light: "github-light", dark: "github-dark-default"},
    }),
  );
}
---

<script>
  import {toast} from "astro-ui/toast";

  const wire = (id: string, fn: () => void) =>
    document.getElementById(id)?.addEventListener("click", fn);
  wire("dm-toast-default", () => toast("Event has been created"));
  wire("dm-toast-success", () => toast.success("Saved!"));
  wire("dm-toast-error", () => toast.error("Something broke"));
  wire("dm-toast-m-default", () => toast("Event has been created"));
  wire("dm-toast-m-success", () => toast.success("Changes saved"));
  wire("dm-toast-m-error", () => toast.error("Failed to save"));
  wire("dm-toast-m-warning", () => toast.warning("Storage almost full"));
  wire("dm-toast-m-info", () => toast.info("New version available"));
  wire("dm-toast-m-loading", () => toast.loading("Uploading…"));
  wire("dm-toast-d-rich", () =>
    toast.warning("Storage almost full", {
      description: "You have used 93% of your plan. Upgrade to keep syncing.",
      richColors: true,
      closeButton: true,
      duration: 8000,
    }),
  );
  wire("dm-toast-d-plain", () =>
    toast.info("Deploy finished", {description: "32 files changed in 4.2s"}),
  );
  wire("dm-toast-d-close", () =>
    toast.info("Session expires soon", {closeButton: true, duration: 10000}),
  );
  wire("dm-toast-act", () =>
    toast("Event has been created", {
      action: {label: "Undo", onClick: () => console.log("Undo")},
    }),
  );
  wire("dm-toast-pos-btn", () =>
    toast("Top-left position", {position: "top-left", duration: 6000}),
  );
  wire("dm-toast-load-btn", () => {
    const id = toast.loading("Uploading…");
    window.setTimeout(() => toast.update(id, {type: "success", title: "Uploaded!"}), 1500);
  });
  wire("dm-toast-x-collapse", () => {
    toast.dismiss();
    for (const msg of ["First", "Second", "Third"]) {
      toast(msg, {duration: 10000});
    }
  });
  wire("dm-toast-x-expand", () => {
    toast.dismiss();
    for (const msg of ["First", "Second", "Third"]) {
      toast(msg, {expand: true, duration: 10000});
    }
  });
</script>

