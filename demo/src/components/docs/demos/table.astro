---
import DemoTabs from "../DemoTabs.astro";
import {
  Table,
} from "astro-ui";

const {demoIds, codeHtml} = Astro.props as {demoIds: string[]; codeHtml: Map<string, string>};
---

<div>
    {demoIds.map((id) => (
      <Fragment>
        {id === "basic" && (
          <div class="docs-demo-block">
            <h3 class="docs-demo-title">Basic</h3>
            <DemoTabs id="dm-table-basic">
              <Fragment slot="preview">
                <Table>
                  <tr slot="head">
                    <th class="aui-table__head-cell">Name</th>
                    <th class="aui-table__head-cell">Role</th>
                  </tr>
                  <tr>
                    <td class="aui-table__cell">Ada Lovelace</td>
                    <td class="aui-table__cell">Developer</td>
                  </tr>
                  <tr>
                    <td class="aui-table__cell">Grace Hopper</td>
                    <td class="aui-table__cell">Engineer</td>
                  </tr>
                </Table>
              </Fragment>
              <Fragment slot="code">
                <pre><code set:html={codeHtml.get("basic")}/></pre>
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "bordered-striped" && (
          <div class="docs-demo-block">
            <h3 class="docs-demo-title">Bordered + striped</h3>
            <DemoTabs id="dm-table-striped">
              <Fragment slot="preview">
                <Table bordered striped>
                  <tr slot="head">
                    <th class="aui-table__head-cell">Name</th>
                    <th class="aui-table__head-cell">Status</th>
                  </tr>
                  <tr>
                    <td class="aui-table__cell">Ada</td>
                    <td class="aui-table__cell">Active</td>
                  </tr>
                  <tr>
                    <td class="aui-table__cell">Grace</td>
                    <td class="aui-table__cell">Active</td>
                  </tr>
                  <tr>
                    <td class="aui-table__cell">Alan</td>
                    <td class="aui-table__cell">Inactive</td>
                  </tr>
                </Table>
              </Fragment>
              <Fragment slot="code">
                <pre><code set:html={codeHtml.get("bordered-striped")}/></pre>
              </Fragment>
            </DemoTabs>
          </div>
        )}
      </Fragment>
    ))}
  </div>
