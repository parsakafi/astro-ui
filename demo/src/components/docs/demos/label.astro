---
import DemoTabs from "../DemoTabs.astro";
import {
  Input,
  Label,
} from "astro-ui";

const {demoIds, codeHtml} = Astro.props as {demoIds: string[]; codeHtml: Map<string, string>};
---

<div>
    {demoIds.map((id) => (
      <Fragment>
        {id === "basic" && (
          <div class="docs-demo-block">
            <h3 class="docs-demo-title">Basic</h3>
            <DemoTabs id="dm-label-basic">
              <Fragment slot="preview">
                <div class="demo-field">
                  <Label for="dm-lbl" required>Email</Label>
                  <Input id="dm-lbl" type="email" placeholder="ada@example.com"/>
                </div>
              </Fragment>
              <Fragment slot="code">
                <pre><code set:html={codeHtml.get("basic")}/></pre>
              </Fragment>
            </DemoTabs>
          </div>
        )}
      </Fragment>
    ))}
  </div>
