{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/index.ts",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/src/**"
      ],
      "outputs": ["dist/**"]
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "test": {},
    "lint": {},
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
