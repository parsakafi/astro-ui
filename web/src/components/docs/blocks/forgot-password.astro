---
import {
  Button,
  Card,
  Input,
} from "@parsakafi/astro-ui";

interface Props {
  /** Prefix for form control ids so multiple instances can coexist. */
  idPrefix?: string;
}

const {idPrefix = "bd"} = Astro.props;

const fid = (name: string) => `${idPrefix}-${name}`;
---

<Card class="docs-block-auth docs-block-auth--narrow">
    <h3 slot="header">Reset your password</h3>
    <div class="docs-block-form">
      <p class="docs-block-hint">Enter your account email and we'll send a recovery link.</p>
      <div class="docs-block-field"><label for={fid("email")}>Email</label><Input type="email" name={fid("email")}
                                                                                  id={fid("email")}
                                                                                  placeholder="you@example.com"/></div>
      <Button class="docs-block-btn-full">Send recovery link</Button>
    </div>
  </Card>
