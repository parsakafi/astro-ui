---
import {
  Button,
  Avatar,
} from "astro-ui";

---

<div class="docs-block-pill-buttons">
    <Button variant="outline" size="sm" shape="rounded" class="docs-block-pill-btn">
      <Avatar name="Ada Lovelace" size="xs"/>
      <span class="docs-block-pill-btn__label">Ada</span>
    </Button>
    <Button variant="outline" size="sm" shape="rounded" class="docs-block-pill-btn">
      <Avatar name="Grace Hopper" size="xs"/>
      <span class="docs-block-pill-btn__label">Grace</span>
    </Button>
    <Button variant="outline" size="sm" shape="rounded" class="docs-block-pill-btn">
      <Avatar name="Alan Turing" size="xs" status="online"/>
      <span class="docs-block-pill-btn__label">Alan</span>
    </Button>
  </div>
