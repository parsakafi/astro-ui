---
import {
  Avatar,
  AvatarGroup,
} from "@parsakafi/astro-ui";
import {Tooltip} from "@parsakafi/astro-ui";

const avatars = [
  {name: "Ada Lovelace"},
  {name: "Grace Hopper"},
  {name: "Alan Turing"},
  {name: "Edsger Dijkstra"},
  {name: "Barbara Liskov"},
];
---

<div class="docs-block-avatar-hover-tooltip">
    <AvatarGroup hover>
      {
        avatars.slice(0, 4).map((a) => (
          <Tooltip ariaLabel={a.name} placement="top">
            <Fragment slot="content">{a.name}</Fragment>
            <Avatar name={a.name}/>
          </Tooltip>
        ))
      }
      <Fragment slot="count">+1</Fragment>
    </AvatarGroup>
  </div>
