---
import {
  Badge,
  Card,
  Chart,
  Tabs,
} from "astro-ui";

---

<div class="docs-block-analytics">
    <div class="docs-block-analytics__kpis">
      <Card size="sm">
        <div class="docs-block-analytics__kpi">
          <span class="docs-block-analytics__kpi-label">Active users</span>
          <span class="docs-block-analytics__kpi-value">24,803</span>
          <Badge variant="success" size="sm">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round" aria-hidden="true" width="10" height="10">
              <path d="M22 7 13.5 15.5 8.5 10.5 2 17"/>
              <path d="M16 7h6v6"/>
            </svg>
            +12.4%
          </Badge>
        </div>
      </Card>
      <Card size="sm">
        <div class="docs-block-analytics__kpi">
          <span class="docs-block-analytics__kpi-label">Sessions</span>
          <span class="docs-block-analytics__kpi-value">108,392</span>
          <Badge variant="success" size="sm">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round" aria-hidden="true" width="10" height="10">
              <path d="M22 7 13.5 15.5 8.5 10.5 2 17"/>
              <path d="M16 7h6v6"/>
            </svg>
            +8.1%
          </Badge>
        </div>
      </Card>
      <Card size="sm">
        <div class="docs-block-analytics__kpi">
          <span class="docs-block-analytics__kpi-label">Bounce rate</span>
          <span class="docs-block-analytics__kpi-value">31.6%</span>
          <Badge variant="error" size="sm">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round" aria-hidden="true" width="10" height="10">
              <path d="m22 17-8.5-8.5-5 5L2 7"/>
              <path d="M16 17h6v-6"/>
            </svg>
            +2.3%
          </Badge>
        </div>
      </Card>
      <Card size="sm">
        <div class="docs-block-analytics__kpi">
          <span class="docs-block-analytics__kpi-label">Avg. session</span>
          <span class="docs-block-analytics__kpi-value">4m 12s</span>
          <Badge variant="muted" size="sm">stable</Badge>
        </div>
      </Card>
    </div>
    <div class="docs-block-analytics__charts">
      <Card class="docs-block-analytics__engagement">
        <div class="docs-block-analytics__panel-head">
          <div>
            <h3 class="docs-block-analytics__panel-title">Engagement</h3>
            <p class="docs-block-analytics__panel-sub">Daily active users</p>
          </div>
        </div>
        <Tabs
          id="bd-analytics-range"
          class="docs-block-analytics__range"
          variant="pill"
          size="xs"
          ariaLabel="Date range"
          defaultValue="7d"
          items={[
            {value: "7d", label: "7d"},
            {value: "30d", label: "30d"},
            {value: "90d", label: "90d"},
          ]}
        >
          <div data-tab="7d">
            <Chart
              type="area"
              curve
              gradient
              grid
              legend
              height={220}
              labels={["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]}
              series={[
                {name: "This week", data: [4200, 5100, 4800, 6400, 7200, 5900, 8100]},
                {name: "Last week", data: [3800, 4200, 4500, 4800, 5200, 6100, 7000]},
              ]}
            />
          </div>
          <div data-tab="30d">
            <Chart
              type="area"
              curve
              gradient
              grid
              legend
              height={220}
              labels={["W1", "W2", "W3", "W4"]}
              series={[
                {name: "This month", data: [31500, 34200, 32800, 38900]},
                {name: "Last month", data: [28400, 30100, 31900, 33400]},
              ]}
            />
          </div>
          <div data-tab="90d">
            <Chart
              type="area"
              curve
              gradient
              grid
              legend
              height={220}
              labels={["May", "Jun", "Jul"]}
              series={[
                {name: "This quarter", data: [121000, 134600, 147200]},
                {name: "Last quarter", data: [108300, 115900, 124100]},
              ]}
            />
          </div>
        </Tabs>
      </Card>
      <Card>
        <div class="docs-block-analytics__panel-head">
          <div>
            <h3 class="docs-block-analytics__panel-title">Traffic sources</h3>
            <p class="docs-block-analytics__panel-sub">Share of sessions</p>
          </div>
        </div>
        <Chart
          type="donut"
          gradient
          height={220}
          labels={["Direct", "Search", "Social", "Referral"]}
          series={[{name: "Share", data: [435, 286, 151, 96]}]}
        />
      </Card>
    </div>
  </div>
