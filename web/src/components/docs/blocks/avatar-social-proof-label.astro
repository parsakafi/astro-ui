---
import {
  Avatar,
  AvatarGroup,
} from "astro-ui";

const avatars = [
  {name: "Ada Lovelace"},
  {name: "Grace Hopper"},
  {name: "Alan Turing"},
  {name: "Edsger Dijkstra"},
  {name: "Barbara Liskov"},
];
---

<div class="docs-block-social-proof-label">
    <AvatarGroup>
      {
        avatars.slice(0, 5).map((a) => (
          <Avatar
            name={a.name}
            size="sm"
            status={a.name === "Ada Lovelace" ? "online" : undefined}
          />
        ))
      }
    </AvatarGroup>
    <div class="docs-block-social-proof-label__text">
      <p class="docs-block-social-proof-label__headline">Joined by 2,411 developers this week</p>
      <p class="docs-block-social-proof-label__sub">See why teams choose this stack for production Astro sites.</p>
    </div>
  </div>
