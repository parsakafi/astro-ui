        {id === "bullet" && (
          <div class="docs-demo-block" id={`demo-chart-${id}`}>
            <h3 class="docs-demo-title">Bullet graph</h3>
            <DemoTabs id="dm-chart-bullet">
              <Fragment slot="preview">
                <Chart
                  type="bullet"
                  title="Q3 performance"
                  description="Actual vs target against qualitative ranges (Few's bullet graph)"
                  height={220}
