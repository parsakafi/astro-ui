              <Fragment slot="preview">
                <Chart
                  type="area"
                  curve
                  gradient
                  title="API requests"
                  description="Series color fades toward the baseline"
                  labels={["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]}
                  series={[{name: "Requests", data: [4200, 5100, 4800, 6300, 7100, 3900, 3400]}]}
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("gradient-area")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "gradient-custom" && (
          <div class="docs-demo-block" id={`demo-chart-${id}`}>
            <h3 class="docs-demo-title">Gradient area, custom color</h3>
            <DemoTabs id="dm-chart-gradient-custom">
              <Fragment slot="preview">
                <Chart
                  type="area"
                  curve
                  gradient
                  title="Revenue"
                  description="The series color drives the line, the fill, and the gradient"
                  labels={["Jan", "Feb", "Mar", "Apr", "May", "Jun"]}
                  series={[{name: "Revenue", data: [12, 18, 15, 22, 19, 26], color: "var(--ui-success)"}]}
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("gradient-custom")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "gradient-bar" && (
          <div class="docs-demo-block" id={`demo-chart-${id}`}>
            <h3 class="docs-demo-title">Gradient bars</h3>
            <DemoTabs id="dm-chart-gradient-bar">
              <Fragment slot="preview">
                <Chart
                  type="bar"
                  gradient
                  title="Deploys per week"
                  description="Each bar fades toward the baseline"
                  labels={["W1", "W2", "W3", "W4", "W5", "W6"]}
                  series={[{name: "Deploys", data: [14, 22, 18, 27, 31, 24]}]}
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("gradient-bar")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "gradient-donut" && (
          <div class="docs-demo-block" id={`demo-chart-${id}`}>
            <h3 class="docs-demo-title">Gradient donut</h3>
            <DemoTabs id="dm-chart-gradient-donut">
              <Fragment slot="preview">
                <Chart
                  type="donut"
                  gradient
                  gradientIntensity={3}
                  title="Storage by type"
                  description="Radial fade — strong at the rim, clear toward the center"
                  labels={["Images", "Video", "Docs", "Other"]}
                  series={[{name: "GB", data: [42, 66, 21, 11]}]}
                  legend={false}
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("gradient-donut")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "donut-rounded" && (
          <div class="docs-demo-block" id={`demo-chart-${id}`}>
            <h3 class="docs-demo-title">Rounded donut (padded slices)</h3>
            <DemoTabs id="dm-chart-donut-rounded">
              <Fragment slot="preview">
                <Chart
                  type="donut"
                  padAngle={4}
                  sliceRadius={22}
                  title="Browser share"
                  description="padAngle gaps the slices, sliceRadius rounds their corners"
                  labels={["Chrome", "Safari", "Firefox", "Edge", "Other"]}
                  series={[{name: "Share", data: [38, 24, 16, 12, 10]}]}
                  legend={false}
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("donut-rounded")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "pie-petal" && (
          <div class="docs-demo-block" id={`demo-chart-${id}`}>
            <h3 class="docs-demo-title">Petal pie (rim-rounded slices)</h3>
            <DemoTabs id="dm-chart-pie-petal">
              <Fragment slot="preview">
                <Chart
                  type="pie"
                  padAngle={2}
                  sliceRadius={18}
                  sliceCorners="outer"
                  title="Vote share"
                  description="Only the rim corners round — the center tip stays sharp"
                  labels={["A", "B", "C", "D", "E", "F"]}
                  series={[{name: "Votes", data: [28, 22, 18, 14, 10, 8]}]}
                  legend={false}
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("pie-petal")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "pie-3d" && (
          <div class="docs-demo-block" id={`demo-chart-${id}`}>
            <h3 class="docs-demo-title">3D pie (extruded)</h3>
            <DemoTabs id="dm-chart-pie-3d">
              <Fragment slot="preview">
                <Chart
                  type="pie3d"
                  title="Share of voice"
                  description="Extruded slices with shaded walls and outside callouts"
                  height={320}
                  labels={["Other", "Signal OS", "Nova Chat", "Pulse", "Wave", "Orbit"]}
                  series={[{name: "Share", data: [22, 21, 16, 15, 14, 12]}]}
                  sliceLabels="label"
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("pie-3d")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "treemap" && (
          <div class="docs-demo-block" id={`demo-chart-${id}`}>
            <h3 class="docs-demo-title">Treemap</h3>
            <DemoTabs id="dm-chart-treemap">
              <Fragment slot="preview">
                <Chart
                  type="treemap"
                  title="Top products"
                  description="Tile area scales with the value — squarified at build time"
                  height={300}
                  labels={["Other", "Nova Chat", "Assistly", "Signal OS", "Atlas AI", "Draft Lab"]}
                  series={[{name: "Users", data: [22, 16, 14, 21, 15, 12]}]}
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("treemap")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "funnel" && (
          <div class="docs-demo-block" id={`demo-chart-${id}`}>
            <h3 class="docs-demo-title">Funnel</h3>
