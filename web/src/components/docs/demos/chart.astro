            <DemoTabs id="dm-chart-rose">
              <Fragment slot="preview">
                <Chart
                  type="rose"
                  title="Cases by month"
                  description="Equal angles, area encodes the value — Nightingale's polar-area manner"
                  labels={["Jan", "Feb", "Mar", "Apr", "May", "Jun"]}
                  series={[{name: "Cases", data: [12, 19, 33, 27, 41, 22]}]}
                  sliceLabels="value"
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("rose")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "histogram" && (
          <div class="docs-demo-block" id={`demo-chart-${id}`}>
            <h3 class="docs-demo-title">Histogram</h3>
            <DemoTabs id="dm-chart-histogram">
              <Fragment slot="preview">
                <Chart
                  type="histogram"
                  title="Response time"
                  description="Raw samples auto-binned (Sturges) into touching bars"
