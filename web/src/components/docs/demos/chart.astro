---
import DemoTabs from "../DemoTabs.astro";
import {
  Chart,
} from "astro-ui";
import {
  countryRegions,
  terrainRows,
  barRevenue,
  groupedDesktop,
  groupedMobile,
  lineThisWeek,
  lineLastWeek,
  forecast,
  strokeActual,
  strokeTarget,
  strokeStretch,
  visitors,
  signups,
  scatterA,
  scatterB,
  pageViews,
  ping,
} from "../../../lib/chart-demo-data";

const {demoIds, codeHtml} = Astro.props as {demoIds: string[]; codeHtml: Map<string, string>};
---

<div>
    {demoIds.map((id) => (
      <Fragment>
        {id === "bar" && (
          <div class="docs-demo-block" id={`demo-chart-${id}`}>
            <h3 class="docs-demo-title">Bar</h3>
            <DemoTabs id="dm-chart-bar">
              <Fragment slot="preview">
                <Chart
                  type="bar"
                  title="Revenue growth"
                  description="Monthly revenue, 2026"
                  labels={["Jan", "Feb", "Mar", "Apr", "May", "Jun"]}
                  series={[{name: "Revenue", data: barRevenue}]}
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("bar")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "grouped-bar" && (
          <div class="docs-demo-block" id={`demo-chart-${id}`}>
            <h3 class="docs-demo-title">Grouped bars</h3>
            <DemoTabs id="dm-chart-grouped">
              <Fragment slot="preview">
                <Chart
                  type="bar"
                  title="Desktop vs mobile"
                  labels={["Jan", "Feb", "Mar", "Apr"]}
                  series={[
                    {name: "Desktop", data: groupedDesktop},
                    {name: "Mobile", data: groupedMobile},
                  ]}
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("grouped-bar")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "stacked-bar" && (
          <div class="docs-demo-block" id={`demo-chart-${id}`}>
            <h3 class="docs-demo-title">Stacked bars</h3>
            <DemoTabs id="dm-chart-stacked">
              <Fragment slot="preview">
                <Chart
                  type="bar"
                  stack
                  title="Sessions by source"
                  description="Stacked per day — axis spans daily totals"
                  labels={["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]}
                  series={[
                    {name: "Direct", data: [320, 360, 310, 420, 480, 260, 210]},
                    {name: "Search", data: [280, 300, 340, 380, 410, 220, 180]},
                    {name: "Social", data: [120, 140, 110, 160, 190, 240, 200]},
                  ]}
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("stacked-bar")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "percent-stack" && (
          <div class="docs-demo-block" id={`demo-chart-${id}`}>
            <h3 class="docs-demo-title">100% stacked bars</h3>
            <DemoTabs id="dm-chart-percent-stack">
              <Fragment slot="preview">
                <Chart
                  type="bar"
                  stack="percent"
                  title="Traffic mix"
                  description="Each column normalized to 100% of its daily total"
                  labels={["Mon", "Tue", "Wed", "Thu", "Fri"]}
                  series={[
                    {name: "Direct", data: [320, 360, 310, 420, 480]},
                    {name: "Search", data: [280, 300, 340, 380, 410]},
                    {name: "Social", data: [120, 140, 110, 160, 190]},
                  ]}
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("percent-stack")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "combo" && (
          <div class="docs-demo-block" id={`demo-chart-${id}`}>
            <h3 class="docs-demo-title">Combo (bars + line)</h3>
            <DemoTabs id="dm-chart-combo">
              <Fragment slot="preview">
                <Chart
                  type="combo"
                  title="Orders vs revenue"
                  description="Bars ride the left axis, the line a secondary right axis"
                  labels={["Oct 1", "Oct 2", "Oct 3", "Oct 4", "Oct 5", "Oct 6", "Oct 7", "Oct 8", "Oct 9"]}
                  series={[
                    {name: "Revenue", data: [4200, 4600, 5100, 4900, 5600, 6100, 6900, 5800, 5400]},
                    {
                      name: "Orders",
                      data: [148, 158, 172, 165, 184, 196, 210, 186, 178],
                      kind: "line",
                      color: "var(--ui-success)"
                    },
                  ]}
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("combo")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "line" && (
          <div class="docs-demo-block" id={`demo-chart-${id}`}>
            <h3 class="docs-demo-title">Line</h3>
            <DemoTabs id="dm-chart-line">
              <Fragment slot="preview">
                <Chart
                  type="line"
                  title="Active users"
                  labels={["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]}
                  series={[
                    {name: "This week", data: lineThisWeek},
                    {name: "Last week", data: lineLastWeek},
                  ]}
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("line")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "step-line" && (
          <div class="docs-demo-block" id={`demo-chart-${id}`}>
            <h3 class="docs-demo-title">Step line</h3>
            <DemoTabs id="dm-chart-step">
              <Fragment slot="preview">
                <Chart
                  type="line"
                  curve="step"
                  title="Desktop vs mobile"
                  description="Plateaus hold until the midpoint between values, then step"
                  labels={["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]}
                  series={[
                    {name: "Desktop", data: [420, 615, 545, 760, 480, 825, 570, 690, 515, 735, 610, 455]},
                    {name: "Mobile", data: [265, 430, 350, 505, 390, 545, 415, 585, 445, 615, 520, 380]},
                  ]}
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("step-line")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "dashed-line" && (
          <div class="docs-demo-block" id={`demo-chart-${id}`}>
            <h3 class="docs-demo-title">Dashed & dotted</h3>
            <DemoTabs id="dm-chart-stroke">
              <Fragment slot="preview">
                <Chart
                  type="line"
                  stroke="dashed"
                  title="Forecast"
                  description="Whole series dashed — chart-level stroke, per-series override"
                  labels={["Apr 1", "Apr 5", "Apr 10", "Apr 15", "Apr 18"]}
                  series={[{name: "Sessions", data: forecast}]}
                />
                <Chart
                  type="line"
                  title="Solid vs dashed vs dotted"
                  labels={["Jan", "Feb", "Mar", "Apr"]}
                  series={[
                    {name: "Actual", data: strokeActual},
                    {name: "Target", data: strokeTarget, stroke: "dashed"},
                    {name: "Stretch", data: strokeStretch, stroke: "dotted"},
                  ]}
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("dashed-line")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "pattern-fill" && (
          <div class="docs-demo-block" id={`demo-chart-${id}`}>
            <h3 class="docs-demo-title">Pattern fills (dots & hatch)</h3>
            <DemoTabs id="dm-chart-pattern">
              <Fragment slot="preview">
                <Chart
                  type="area"
                  curve="step"
                  fill="dots"
                  title="Portfolio swing"
                  description="Texture fills tinted with each series color"
                  labels={["W1", "W2", "W3", "W4", "W5", "W6", "W7", "W8"]}
                  series={[
                    {name: "Fund A", data: [312, 388, 340, 296, 274, 246, 231, 224]},
                    {name: "Fund B", data: [268, 231, 205, 214, 248, 289, 331, 352], fill: "hatch"},
                  ]}
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("pattern-fill")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "pattern-mix" && (
          <div class="docs-demo-block" id={`demo-chart-${id}`}>
            <h3 class="docs-demo-title">Actual vs target (hatch + bare line)</h3>
            <DemoTabs id="dm-chart-pattern-mix">
              <Fragment slot="preview">
                <Chart
                  type="area"
                  curve="step"
                  title="Weekly signups"
                  description="275 this week — +12.2% vs target"
                  labels={["Jan", "Feb", "Mar", "Apr", "May", "Jun"]}
                  series={[
                    {name: "Actual", data: [240, 178, 262, 335, 212, 275], fill: "hatch"},
                    {name: "Target", data: [122, 202, 128, 390, 305, 172], fill: "none", stroke: "dashed"},
                  ]}
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("pattern-mix")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "bump-line" && (
          <div class="docs-demo-block" id={`demo-chart-${id}`}>
            <h3 class="docs-demo-title">Bump curve</h3>
            <DemoTabs id="dm-chart-bump">
              <Fragment slot="preview">
                <Chart
                  type="line"
                  curve="bump"
                  title="Rank changes"
                  description="Flat out of each point, S-curve into the next"
                  labels={["Jan", "Feb", "Mar", "Apr", "May", "Jun"]}
                  series={[
                    {name: "Desktop", data: [320, 180, 420, 260, 510, 380]},
                    {name: "Mobile", data: [180, 320, 240, 450, 290, 460]},
                  ]}
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("bump-line")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "curved-line" && (
          <div class="docs-demo-block" id={`demo-chart-${id}`}>
            <h3 class="docs-demo-title">Curved line</h3>
            <DemoTabs id="dm-chart-curved">
              <Fragment slot="preview">
                <Chart
                  type="line"
                  curve
                  title="Visitor flow"
                  description="Monotone cubic smoothing — the curve never overshoots the data"
                  labels={["Jan", "Feb", "Mar", "Apr", "May", "Jun"]}
                  series={[{name: "Visitor-line", data: visitors}]}
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("curved-line")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "area" && (
          <div class="docs-demo-block" id={`demo-chart-${id}`}>
            <h3 class="docs-demo-title">Area</h3>
            <DemoTabs id="dm-chart-area">
              <Fragment slot="preview">
                <Chart
                  type="area"
                  title="Signups"
                  labels={["Q1", "Q2", "Q3", "Q4"]}
                  series={[{name: "Signups", data: signups}]}
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("area")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "curved-area" && (
          <div class="docs-demo-block" id={`demo-chart-${id}`}>
            <h3 class="docs-demo-title">Curved area</h3>
            <DemoTabs id="dm-chart-curved-area">
              <Fragment slot="preview">
                <Chart
                  type="area"
                  curve
                  title="Campaign traffic"
                  description="Smoothed area — the fill follows the monotone curve"
                  labels={["Jan", "Feb", "Mar", "Apr", "May", "Jun"]}
                  series={[{name: "Sessions", data: [820, 1210, 940, 580, 1120, 990]}]}
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("curved-area")} />
              </Fragment>
            </DemoTabs>
