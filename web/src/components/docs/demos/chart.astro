              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "waffle" && (
          <div class="docs-demo-block" id={`demo-chart-${id}`}>
            <h3 class="docs-demo-title">Waffle</h3>
            <DemoTabs id="dm-chart-waffle">
              <Fragment slot="preview">
                <Chart
                  type="waffle"
                  title="Market share"
