---
import DemoTabs from "../DemoTabs.astro";
import {
  StickySurface,
} from "@parsakafi/astro-ui";

const {demoIds, codeHtml} = Astro.props as {demoIds: string[]; codeHtml: Map<string, string>};
---

<div>
    {demoIds.map((id) => (
      <Fragment>
        {id === "toolbar" && (
          <div class="docs-demo-block" id={`demo-sticky-surface-${id}`}>
            <h3 class="docs-demo-title">Toolbar</h3>
            <DemoTabs id="dm-sticky-surface-toolbar">
              <Fragment slot="preview">
                <div tabindex="0" role="region" aria-label="Sticky toolbar demo" style="max-height: 320px; overflow-y: auto; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-md);">
                  <StickySurface effects={["line", "elevate"]} threshold="0px">
                    <div style="display: flex; align-items: center; justify-content: space-between; padding: var(--ui-space-3) var(--ui-space-4);">
                      <strong>Toolbar</strong>
                      <span style="color: var(--ui-muted-foreground); font-size: var(--ui-text-sm);">Scroll the box</span>
                    </div>
                  </StickySurface>
                  <div style="padding: var(--ui-space-4); display: grid; gap: var(--ui-space-3);">
                    <h4 style="margin: 0;">Release notes 1.1</h4>
                    <p style="margin: 0;">This release adds six chart types, a vivid categorical palette, and round-number axis ticks across every cartesian chart.</p>
                    <figure class="demo-placeholder" style="aspect-ratio: 16 / 9;">
                      <span>Release banner · 16 × 9</span>
                    </figure>
                    <p style="margin: 0;">The categorical palette moves off semantic colors: rose, sky, green, amber, violet, and teal keep adjacent series distinct in both themes.</p>
                    <h4 style="margin: 0;">Breaking changes</h4>
                    <p style="margin: 0;">None. Explicit maxY overrides stay exact, and 100% stacking keeps its 0–100 scale; only default ceilings gained headroom.</p>
                    <figure class="demo-placeholder" style="aspect-ratio: 4 / 3;">
                      <span>Migration sketch · 4 × 3</span>
                    </figure>
                    <p style="margin: 0;">See the changelog for the full list, then the token playground to retheme the new palette.</p>
                  </div>
                </div>
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("toolbar")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "glass" && (
          <div class="docs-demo-block" id={`demo-sticky-surface-${id}`}>
            <h3 class="docs-demo-title">Glass header</h3>
            <DemoTabs id="dm-sticky-surface-glass">
              <Fragment slot="preview">
                <div tabindex="0" role="region" aria-label="Glass header demo" style="max-height: 320px; overflow-y: auto; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-md);">
                  <StickySurface as="header" effects={["backdrop"]} threshold="8px">
                    <div style="padding: var(--ui-space-3) var(--ui-space-4);">
                      <strong>Glass header</strong>
                    </div>
                  </StickySurface>
                  <div style="padding: var(--ui-space-4); display: grid; gap: var(--ui-space-3);">
                    <h4 style="margin: 0;">Field guide</h4>
                    <p style="margin: 0;">Watch this header as you scroll: the frosted wash fades in over the content behind it, keeping the title legible without a solid bar.</p>
                    <figure class="demo-placeholder" style="aspect-ratio: 16 / 9;">
                      <span>Hero visual · 16 × 9</span>
                    </figure>
                    <p style="margin: 0;">Glass works best over varied content — text, media, and color all blur into a calm backdrop instead of fighting the header.</p>
                    <h4 style="margin: 0;">When to use it</h4>
                    <p style="margin: 0;">Overlapping media heroes, dashboards with dense grids, and any surface where a solid bar would feel heavy.</p>
                    <figure class="demo-placeholder" style="aspect-ratio: 1 / 1;">
                      <span>Detail crop · 1 × 1</span>
                    </figure>
                    <p style="margin: 0;">Pair with the line effect when the wash alone does not separate the header strongly enough.</p>
                  </div>
                </div>
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("glass")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "stuck-hook" && (
          <div class="docs-demo-block" id={`demo-sticky-surface-${id}`}>
            <h3 class="docs-demo-title">Stuck-state hook</h3>
            <DemoTabs id="dm-sticky-surface-hook">
              <Fragment slot="preview">
                <div tabindex="0" role="region" aria-label="Stuck-state demo" style="max-height: 320px; overflow-y: auto; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-md);">
                  <StickySurface id="dm-sticky-hook-surface" observeStuck threshold="0px">
                    <div style="padding: var(--ui-space-3) var(--ui-space-4);">
                      <strong>Toolbar</strong>
                    </div>
                  </StickySurface>
                  <div style="padding: var(--ui-space-4); display: grid; gap: var(--ui-space-3);">
                    <p id="dm-sticky-hook-status">Not stuck — scroll the box.</p>
                    <figure class="demo-placeholder" style="aspect-ratio: 16 / 9;">
                      <span>Hook diagram · 16 × 9</span>
                    </figure>
                    <p style="margin: 0;">The status line above mirrors the <code>is-stuck</code> class through a MutationObserver — the same hook your own CSS or scripts can use.</p>
                    <p style="margin: 0;">Try conditional styles, collapsing chrome, or analytics events keyed off stuck transitions.</p>
                    <figure class="demo-placeholder" style="aspect-ratio: 4 / 3;">
                      <span>Usage sketch · 4 × 3</span>
                    </figure>
                    <p style="margin: 0;">No visual effects ship with this surface; everything you see in the status line comes from the hook alone.</p>
                  </div>
                </div>
                <script>
                  const surface = document.getElementById("dm-sticky-hook-surface");
                  const status = document.getElementById("dm-sticky-hook-status");
                  let sticks = 0;
                  let wasStuck = false;
                  if (surface && status) {
                    new MutationObserver(() => {
                      const stuck = surface.classList.contains("is-stuck");
                      if (stuck && !wasStuck) sticks += 1;
                      wasStuck = stuck;
                      status.textContent = stuck ? `Stuck — entered ${sticks} time${sticks === 1 ? "" : "s"}` : "Not stuck — scroll the box.";
                    }).observe(surface, {attributes: true, attributeFilter: ["class"]});
                  }
                </script>
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("stuck-hook")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
      </Fragment>
    ))}
  </div>
