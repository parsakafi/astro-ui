---
import DemoTabs from "../DemoTabs.astro";
import {
  Badge,
  Breadcrumb,
  Button,
  Card,
  Popover,
} from "astro-ui";

const {demoIds, codeHtml} = Astro.props as {demoIds: string[]; codeHtml: Map<string, string>};
---

<div>
    {demoIds.map((id) => (
      <Fragment>
        {id === "basic" && (
          <div class="docs-demo-block" id={`demo-breadcrumb-${id}`}>
            <h3 class="docs-demo-title">Basic</h3>
            <DemoTabs id="dm-breadcrumb-basic">
              <Fragment slot="preview">
                <Breadcrumb
                  items={[
                    {href: "/", label: "Home"},
                    {href: "/components/", label: "Components"},
                    {label: "Button"},
                  ]}
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("basic")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "chevron" && (
          <div class="docs-demo-block" id={`demo-breadcrumb-${id}`}>
            <h3 class="docs-demo-title">Chevron separator</h3>
            <DemoTabs id="dm-breadcrumb-chevron">
              <Fragment slot="preview">
                <Breadcrumb
                  separator="chevron"
                  items={[
                    {href: "/", label: "Home"},
                    {label: "Docs"},
                  ]}
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("chevron")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "dropdown" && (
          <div class="docs-demo-block" id={`demo-breadcrumb-${id}`}>
            <h3 class="docs-demo-title">Breadcrumb with dropdown menu</h3>
            <DemoTabs id="dm-breadcrumb-dropdown">
              <Fragment slot="preview">
                <Breadcrumb ariaLabel="Breadcrumb with collapsed path">
							<span class="aui-breadcrumb__item">
								<a class="aui-breadcrumb__link" href="/">Home</a>
							</span>
                  <span class="aui-breadcrumb__item">
								<Popover id="bc-menu" triggerLabel="Show hidden path segments">
									<span slot="trigger">
										<span class="aui-breadcrumb__ellipsis" aria-hidden="true">…</span>
									</span>
									<span slot="content" class="docs-breadcrumb-menu">
										<a href="#">Documentation</a>
										<a href="#">Themes</a>
										<a href="#">GitHub</a>
									</span>
								</Popover>
							</span>
                  <span class="aui-breadcrumb__item">
								<a class="aui-breadcrumb__link" href="#">Components</a>
							</span>
                  <span class="aui-breadcrumb__item">
								<span class="aui-breadcrumb__current" aria-current="page">Breadcrumb</span>
							</span>
                </Breadcrumb>
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("dropdown")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "slash" && (
          <div class="docs-demo-block" id={`demo-breadcrumb-${id}`}>
            <h3 class="docs-demo-title">Custom slash separator</h3>
            <DemoTabs id="dm-breadcrumb-slash">
              <Fragment slot="preview">
                <div class="demo-row">
                  <Breadcrumb
                    separator="custom"
                    style="--aui-breadcrumb-separator: '//'"
                    items={[
                      {href: "/", label: "usr"},
                      {href: "#", label: "local"},
                      {label: "bin"},
                    ]}
                  />
                  <Breadcrumb
                    separator="custom"
                    style="--aui-breadcrumb-separator: '\\2022'"
                    items={[
                      {href: "/", label: "Home"},
                      {label: "Settings"},
                    ]}
                  />
                </div>
                <p class="docs-demo-hint">Custom glyphs — double slash and bullet — via <code>separator="custom"</code>.
                </p>
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("slash")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "ellipsis" && (
          <div class="docs-demo-block" id={`demo-breadcrumb-${id}`}>
            <h3 class="docs-demo-title">Ellipsis for long paths</h3>
            <DemoTabs id="dm-breadcrumb-ellipsis">
              <Fragment slot="preview">
                <Breadcrumb
                  items={[
                    {href: "/", label: "Home"},
                    {ellipsis: true, label: "More"},
                    {href: "#", label: "Components"},
                    {label: "Breadcrumb"},
                  ]}
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("ellipsis")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "icons" && (
          <div class="docs-demo-block" id={`demo-breadcrumb-${id}`}>
            <h3 class="docs-demo-title">Icons for each item</h3>
            <DemoTabs id="dm-breadcrumb-icons">
              <Fragment slot="preview">
                <Breadcrumb separator="chevron"
                            items={[
                              {
                                href: "/",
                                label: "Home",
                                icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>'
                              },
                              {
                                href: "#",
                                label: "Library",
                                icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>'
                              },
                              {
                                label: "Breadcrumb",
                                icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M15 2v5h5"/></svg>'
                              },
                            ]}
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("icons")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "chevrons" && (
          <div class="docs-demo-block" id={`demo-breadcrumb-${id}`}>
            <h3 class="docs-demo-title">Double chevron separators</h3>
            <DemoTabs id="dm-breadcrumb-chevrons">
              <Fragment slot="preview">
                <Breadcrumb separator="chevrons"
                            items={[
                              {href: "/", label: "Dashboard"},
                              {href: "#", label: "Resources"},
                              {label: "Documentation"},
                            ]}
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("chevrons")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "pill-frame" && (
          <div class="docs-demo-block" id={`demo-breadcrumb-${id}`}>
            <h3 class="docs-demo-title">Pill-style breadcrumb inside frame</h3>
            <DemoTabs id="dm-breadcrumb-pill">
              <Fragment slot="preview">
                <div class="docs-breadcrumb-frame">
                  <Breadcrumb pill separator="chevron"
                              items={[
                                {
                                  href: "/",
                                  label: "Home",
                                  icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>'
                                },
                                {href: "#", label: "Products"},
                                {label: "Checkout"},
                              ]}
                  />
                </div>
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("pill-frame")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "home-icon" && (
          <div class="docs-demo-block" id={`demo-breadcrumb-${id}`}>
            <h3 class="docs-demo-title">Home icon item</h3>
            <DemoTabs id="dm-breadcrumb-home">
              <Fragment slot="preview">
                <Breadcrumb
                  items={[
                    {
                      href: "/",
                      label: "Home",
                      icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>'
                    },
                    {href: "#", label: "Products"},
                    {label: "Checkout"},
                  ]}
                />
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("home-icon")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "badge-count" && (
          <div class="docs-demo-block" id={`demo-breadcrumb-${id}`}>
            <h3 class="docs-demo-title">Badge with count</h3>
            <DemoTabs id="dm-breadcrumb-badge">
              <Fragment slot="preview">
                <Breadcrumb ariaLabel="Mailbox">
							<span class="aui-breadcrumb__item">
								<a class="aui-breadcrumb__link" href="#">
									Inbox
									<Badge variant="destructive" size="sm" ariaLabel="3 unread messages" style="min-inline-size: 1.25rem">3</Badge>
								</a>
							</span>
                  <span class="aui-breadcrumb__item">
								<a class="aui-breadcrumb__link" href="#">Labels</a>
							</span>
                  <span class="aui-breadcrumb__item">
								<span class="aui-breadcrumb__current" aria-current="page">Important</span>
							</span>
                </Breadcrumb>
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("badge-count")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "buttons" && (
          <div class="docs-demo-block" id={`demo-breadcrumb-${id}`}>
            <h3 class="docs-demo-title">Button-style breadcrumb</h3>
            <DemoTabs id="dm-breadcrumb-buttons">
              <Fragment slot="preview">
                <Breadcrumb ariaLabel="Help center">
							<span class="aui-breadcrumb__item">
							<Button variant="outline" size="xs" shape="rounded" aria-label="Home">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path
                  d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>
							</Button>
							</span>
                  <span class="aui-breadcrumb__item">
								<a class="aui-breadcrumb__link" href="#">Help Center</a>
							</span>
                  <span class="aui-breadcrumb__item">
								<span class="aui-breadcrumb__current" aria-current="page">Getting Started</span>
							</span>
                </Breadcrumb>
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("buttons")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
        {id === "card" && (
          <div class="docs-demo-block" id={`demo-breadcrumb-${id}`}>
            <h3 class="docs-demo-title">Breadcrumb inside card</h3>
            <DemoTabs id="dm-breadcrumb-card">
              <Fragment slot="preview">
                <Card size="sm">
                  <Breadcrumb separator="chevron"
                              items={[
                                {href: "/", label: "Home"},
                                {href: "#", label: "Products"},
                                {label: "Checkout"},
                              ]}
                  />
                </Card>
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("card")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
      </Fragment>
    ))}
  </div>
