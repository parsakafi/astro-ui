---
import DemoTabs from "../DemoTabs.astro";
import {
  Tag,
} from "@parsakafi/astro-ui";

const {demoIds, codeHtml} = Astro.props as {demoIds: string[]; codeHtml: Map<string, string>};
---

<div>
    {demoIds.map((id) => (
      <Fragment>
        {id === "basic" && (
          <div class="docs-demo-block" id={`demo-tag-${id}`}>
            <h3 class="docs-demo-title">Variants &amp; shapes</h3>
            <DemoTabs id="dm-tag-basic">
              <Fragment slot="preview">
                <Tag>astro</Tag>
                <Tag variant="soft">design</Tag>
                <Tag variant="outline">zero-js</Tag>
                <Tag variant="success" shape="square">stable</Tag>
                <Tag variant="info" closable closeLabel="Remove token">tokens</Tag>
              </Fragment>
              <Fragment slot="code">
                <Fragment set:html={codeHtml.get("basic")} />
              </Fragment>
            </DemoTabs>
          </div>
        )}
      </Fragment>
    ))}
  </div>
