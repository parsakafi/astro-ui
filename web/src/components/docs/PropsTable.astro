---
/**
  * PropsTable — API reference table rendered from registry data.
  */
import type {PropRow} from "../../lib/components";

interface Props {
  rows: PropRow[];
}

const {rows} = Astro.props;
---

<div class="docs-table-wrap">
  <table class="docs-table">
    <thead>
    <tr>
      <th scope="col">Prop</th>
      <th scope="col">Type</th>
      <th scope="col">Default</th>
      <th scope="col">Description</th>
    </tr>
    </thead>
    <tbody>
    {
      rows.map((row) => (
        <tr>
          <td data-label="Prop">
            <code class="docs-code-pill">{row.name}</code>
          </td>
          <td data-label="Type">
            <code class="docs-code-type">{row.type}</code>
          </td>
          <td data-label="Default">
            <code>{row.def}</code>
          </td>
          <td data-label="Description">{row.description}</td>
        </tr>
      ))
    }
    </tbody>
  </table>
</div>
