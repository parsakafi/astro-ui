---
/**
 * BlockTabs — Preview/Code switcher for a single block, mirroring the
 * component demo UX (DemoTabs) so blocks feel first-class: live
 * preview on one tab, highlighted copy-paste-ready Astro source on
 * the other. Same code-tab structure as component demos — a bare
 * Shiki <pre> plus DemoTabs' built-in copy button.
 */
import DemoTabs from "./DemoTabs.astro";
import BlockDemo from "./BlockDemo.astro";
import {codeToHtml} from "shiki";
import {blockCode} from "../../lib/block-code";

interface Props {
  /** Unique id prefixing the generated tab/panel ids. */
  id: string;
  /** Block id from the registry (rendered live in the preview tab). */
  blockId: string;
  /** Copy-paste-ready Astro source; defaults to the registry snippet. */
  code?: string;
  /** Instance prefix forwarded to BlockDemo (form-control ids). */
  idPrefix?: string;
}

const {id, blockId, code, idPrefix = "bt"} = Astro.props;
const source = code ?? blockCode[blockId] ?? `<!-- No source registered for "${blockId}" -->`;

const highlighted = await codeToHtml(source.trim(), {
  lang: "astro",
  themes: {light: "github-light", dark: "github-dark-default"},
});
---

<div class="docs-block-tabs">
  <DemoTabs id={id}>
    <Fragment slot="preview">
      <BlockDemo id={blockId} idPrefix={idPrefix}/>
    </Fragment>
    <Fragment slot="code">
      {/* codeToHtml returns a full <pre class="shiki"> — inserting it
			    verbatim (no wrapper pre of our own) keeps exactly one
			    scroll container, same as component demos. */}
      <Fragment set:html={highlighted}/>
    </Fragment>
  </DemoTabs>
</div>
