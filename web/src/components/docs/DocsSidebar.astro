---
/**
  * DocsSidebar — left category/component tree for the docs layout.
  * Server-rendered; the current page highlights via `currentSlug`.
  * Component metadata comes from the components content collection.
  */
import {categories} from "../../lib/components";
import {docsComponentOrder} from "../../lib/docs-order";

interface Props {
  /** Component slug of the current page (highlights in the tree). */
  currentSlug?: string;
  /** Whether the current page is the catalog root. */
  isCatalog?: boolean;
}

const {currentSlug, isCatalog = false} = Astro.props;
const entries = await docsComponentOrder();
const metas = entries.map((d) => d.data);
---

<nav class="docs-sidebar" aria-label="Components">
  {/* Mobile: the tree collapses behind a summary so pages don't start
      under 65 links. Desktop hides the summary and shows it expanded. */}
  <details class="docs-sidebar-details" open data-docs-sidebar-details>
    <summary class="docs-sidebar-toggle">
      <span>Browse components</span>
      <span class="docs-sidebar-toggle-count">{metas.length}</span>
      <svg class="docs-sidebar-toggle-chevron" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </summary>
    <div class="docs-sidebar-body">
      <div class="docs-search">
        <input
          type="search"
          class="docs-search-input"
          placeholder="Search components…"
          aria-label="Search components"
          autocomplete="off"
          spellcheck="false"
          data-docs-search
        />
        <p class="docs-search-empty" role="status" hidden data-docs-search-empty>
          No components match.
        </p>
      </div>
      <a class:list={{"docs-side-link": true, "is-active": isCatalog}} href="/components/">
        Component Catalog
      </a>
      {
        categories.map((category) => (
          <div class="docs-side-group">
            <a class="docs-side-cat" href={`/components/#cat-${category.id}`}>
						<span class="docs-side-cat-icon" aria-hidden="true">
							{category.icon}
						</span> {category.name}
              <span class="docs-side-count">{metas.filter((m) => m.category === category.id).length}</span>
            </a>
            <div class="docs-side-items">
              {metas
                .filter((m) => m.category === category.id)
                .map((component) => (
                  <a
                    class:list={{
                      "docs-side-link": true,
                      "is-active": currentSlug === component.slug,
                    }}
                    aria-current={currentSlug === component.slug ? "page" : undefined}
                    href={`/components/${component.slug}/`}
                    data-search-name={component.name.toLowerCase()}
                  >
                    {component.name}
                    {component.isNew && <span class="docs-new-badge">New</span>}
                  </a>
                ))}
            </div>
          </div>
        ))
      }
    </div>
  </details>
</nav>

{/* Inline (not bundled) so the panel is already closed during the first
    paint on mobile — no flash of the full list before hydration. */}
<script is:inline>
  (() => {
    const details = document.querySelector("[data-docs-sidebar-details]");
    if (details && window.matchMedia("(max-width: 64rem)").matches) {
      details.open = false;
    }
  })();
</script>

<script>
  const input = document.querySelector<HTMLInputElement>("[data-docs-search]");
  const nav = input?.closest<HTMLElement>(".docs-sidebar");

  if (input && nav) {
    const details = nav.querySelector<HTMLDetailsElement>(
      "[data-docs-sidebar-details]",
    );
    const body = nav.querySelector<HTMLElement>(".docs-sidebar-body");
    const mobile = window.matchMedia("(max-width: 64rem)");

    // The disclosure only exists on mobile; above the breakpoint the tree
    // is always visible, so reopening after a resize keeps it usable.
    mobile.addEventListener("change", (event) => {
      if (!event.matches && details) details.open = true;
    });

    const links = Array.from(
      nav.querySelectorAll<HTMLAnchorElement>("[data-search-name]"),
    );
    const groups = Array.from(
      nav.querySelectorAll<HTMLElement>(".docs-side-group"),
    );
    const empty = nav.querySelector<HTMLElement>("[data-docs-search-empty]");

    /** Hides non-matching links (and groups left empty). Returns match count. */
    const filter = (): number => {
      const query = input.value.trim().toLowerCase();
      // Typing must reveal the results, even when the panel is closed.
      if (query && details) details.open = true;
      let visible = 0;
      for (const link of links) {
        const match = link.dataset.searchName?.includes(query) ?? false;
        link.hidden = query !== "" && !match;
        if (!link.hidden) visible++;
      }
      for (const group of groups) {
        const shown = Array.from(
          group.querySelectorAll<HTMLAnchorElement>("[data-search-name]"),
        ).some((link) => !link.hidden);
        group.hidden = !shown;
      }
      if (empty) empty.hidden = !(query && visible === 0);
      return visible;
    };

    input.addEventListener("input", () => {
      filter();
    });

    input.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        input.value = "";
        filter();
        return;
      }
      if (event.key !== "Enter") return;
      const query = input.value.trim().toLowerCase();
      if (!query) return;
      // Prefer exact name, then prefix, then first visible match.
      const target =
        links.find((link) => !link.hidden && link.dataset.searchName === query) ??
        links.find(
          (link) => !link.hidden && (link.dataset.searchName?.startsWith(query) ?? false),
        ) ??
        links.find((link) => !link.hidden);
      if (target) {
        event.preventDefault();
        location.href = target.href;
      }
    });

    // Keep the current page's link centered in whichever element scrolls:
    // the panel body on mobile, the sidebar itself on desktop.
    const centerActive = (): void => {
      const active = nav.querySelector<HTMLElement>(".docs-side-link.is-active");
      if (!active) return;
      const scroller =
        body && body.scrollHeight > body.clientHeight + 1 ? body : nav;
      const areaRect = scroller.getBoundingClientRect();
      const linkRect = active.getBoundingClientRect();
      scroller.scrollTop +=
        linkRect.top - areaRect.top - scroller.clientHeight / 2 + linkRect.height / 2;
    };

    centerActive();

    details?.addEventListener("toggle", () => {
      if (details?.open) requestAnimationFrame(centerActive);
    });
  }
</script>
