---
/**
  * SiteFooter — multi-column footer: brand blurb, link
  * columns (library, docs, community), and a live component strip.
  */
import {SITE} from "../../lib/site";
import Badge from "@parsakafi/astro-ui/badge";
import Kbd from "@parsakafi/astro-ui/kbd";

const columns = [
  {
    title: "Library",
    links: [
      {href: "/components/", label: "Components"},
      {href: "/blocks/", label: "Blocks"},
    ],
  },
  {
    title: "Docs",
    links: [
      {href: "/docs/", label: "Introduction"},
      {href: "/docs/get-started/", label: "Get started"},
      {href: "/docs/styling/", label: "Styling"},
      {href: "/docs/rtl/", label: "RTL support"},
      {href: "/docs/changelog/", label: "Changelog"},
      {href: "/docs/releases/", label: "Releases"},
      {href: "/docs/roadmap/", label: "Roadmap"},
    ],
  },
  {
    title: "Popular components",
    links: [
      {href: "/components/button/", label: "Button"},
      {href: "/components/dialog/", label: "Dialog"},
      {href: "/components/table/", label: "Table"},
      {href: "/components/toast/", label: "Toast"},
      {href: "/components/tabs/", label: "Tabs"},
    ],
  },
  {
    title: "Popular blocks",
    links: [
      {href: "/blocks/application/", label: "Application"},
      {href: "/blocks/social/", label: "Social"},
      {href: "/blocks/navigation/", label: "Navigation"},
      {href: "/blocks/auth/", label: "Auth"},
      {href: "/blocks/marketing/", label: "Marketing"},
      {href: "/blocks/content/", label: "Content"},
    ],
  },
  {
    title: "Community",
    links: [
      {href: SITE.repo, label: "GitHub ↗"},
      {href: "https://astro.build/", label: "Astro ↗"},
      {href: "https://astro.build/chat/", label: "Astro Discord ↗"},
    ],
  },
];
---

<footer class="docs-footer docs-footer-mega">
  <div class="docs-footer-grid">
    <div class="docs-footer-brand">
      <a class="docs-brand" href="/">
        <span class="docs-brand-mark" aria-hidden="true">▲</span>
        {SITE.name}
        <Badge variant="muted" size="sm">{SITE.version}</Badge>
      </a>
      <p>
        A zero-first component library for Astro — native elements, design
        tokens, and progressive enhancement. Server-rendered, accessible,
        RTL-ready.
      </p>
      <p class="docs-footer-kbd">
        Press <Kbd size="sm">Ctrl</Kbd> + <Kbd size="sm">K</Kbd> to search the
        catalog.
      </p>
    </div>
    {
      columns.map((col) => (
        <nav class="docs-footer-col" aria-label={col.title}>
          <p class="docs-footer-title">{col.title}</p>
          <ul>
            {col.links.map((link) => (
              <li>
                <a href={link.href} rel={link.href.startsWith("http") ? "noreferrer noopener" : undefined}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="docs-footer-base">
    <p>
      Built with <a href="https://astro.build/" target="_blank" rel="noreferrer noopener">Astro</a>
      — components ship zero JS unless a platform primitive needs it.
    </p>
    <p>© {new Date().getFullYear()} {SITE.name}. MIT licensed.</p>
  </div>
</footer>
