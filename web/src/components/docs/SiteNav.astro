  Social:
    '<circle cx="5.5" cy="5.5" r="2.5" /><circle cx="10.5" cy="5.5" r="2.5" /><path d="M2.5 13.5c0-2 1.5-3 3-3s3 1 3 3M8 13.5c0-2 1.5-3 3-3s3 1 3 3" />',
  Content:
    '<path d="M4 1.5h5.5L13 5v9.5H4z" /><path d="M9.5 1.5V5H13M6 8.5h4M6 11h4" />',
  Documentation:
    '<path d="M3 3a1.5 1.5 0 0 1 1.5-1.5H13V13H4.5A1.5 1.5 0 0 0 3 14.5z" /><path d="M13 10.5H4.5A1.5 1.5 0 0 0 3 12" />',
  "Get started":
    '<circle cx="8" cy="8" r="5.5" /><path d="M6.8 6l3.2 2-3.2 2z" />',
  Styling:
    '<path d="M8 1.8s4.5 4.6 4.5 8a4.5 4.5 0 0 1-9 0c0-3.4 4.5-8 4.5-8z" />',
  RTL:
    '<path d="M2.5 5.5h11M11 3l2.5 2.5L11 8" /><path d="M13.5 10.5h-11M5 8l-2.5 2.5L5 13" />',
  Changelog:
    '<circle cx="8" cy="8" r="5.5" /><path d="M8 4.5V8l2.5 1.5" />',
  Releases:
    '<path d="M2.5 7.2V2.5h4.7L14 9.3 9.3 14z" /><circle cx="5.5" cy="5.5" r="1" />',
  Roadmap:
    '<path d="M8 14s4.5-4 4.5-7.5a4.5 4.5 0 0 0-9 0C3.5 10 8 14 8 14z" /><circle cx="8" cy="6.5" r="1.5" />',
  GitHub:
    '<path d="M6.5 3.5h-4v10h10v-4" /><path d="M9.5 2.5h4v4M13.5 2.5 7.5 8.5" />',
};
---

<header class="docs-header">
  <nav class="docs-nav" aria-label="Main">
    <a class="docs-brand" href="/">
      <span class="docs-brand-mark" aria-hidden="true">▲</span>
      {SITE.name}
      <span class="docs-brand-version">{SITE.version}</span>
    </a>

    <div class="docs-nav-links">
      {
        menus.map((menu) => (
          <div class="docs-mega" data-mega={menu.id}>
            <button
              type="button"
              class:list={{
                "docs-nav-link": true,
                "docs-mega-trigger": true,
                "is-active": active.startsWith(menu.match)
              }}
              aria-expanded="false"
              aria-controls={`mega-${menu.id}`}
            >
              {menu.label}
              <svg class="docs-mega-chevron" width="10" height="10" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                      stroke-linejoin="round"/>
              </svg>
            </button>
            <div class="docs-mega-panel" id={`mega-${menu.id}`} role="group" aria-label={`${menu.label} menu`}>
              <div class="docs-mega-grid">
                {menu.sections.map((section) => (
                  <div class="docs-mega-section">
                    <p class="docs-mega-label">{section.label}</p>
                    <ul class="docs-mega-list">              {section.links.map((link) => (
                      <li>
                        <a
                          class:list={{"docs-mega-link": true, "docs-mega-link--featured": link.featured}}
                          href={link.href}
                        >
                          {menuIcons[link.title] && (
                            <svg
                              class="docs-mega-icon"
                              width="16"
                              height="16"
                              viewBox="0 0 16 16"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              aria-hidden="true"
                              set:html={menuIcons[link.title]}
                            />
                          )}
                          <span class="docs-mega-text">
											<span class="docs-mega-title">{link.title}</span>
											<span class="docs-mega-desc">{link.desc}</span>
										</span>
                          {link.featured && (
                            <svg class="docs-mega-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none"
                                 aria-hidden="true">
                              <path d="M3 8h9.5M9 4.5 12.5 8 9 11.5" stroke="currentColor" stroke-width="1.5"
                                    stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          )}
                        </a>
                      </li>
                    ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="docs-nav-end">
      <SearchPalette/>
      <a class="docs-nav-link docs-github-link" href={SITE.repo} target="_blank" rel="noreferrer noopener"
         aria-label="GitHub repository">
        <svg class="docs-github-icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
        </svg>
        <span class="docs-github-label">GitHub</span>
      </a>
      <a class="docs-nav-link docs-npm-link" href={SITE.npm} target="_blank" rel="noreferrer noopener"
         aria-label="npm package">
        <svg class="docs-npm-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M0 7.334v8h6.666v1.332H12v-1.332h12v-8H0zm6.666 6.664H5.334v-4H3.999v4H1.335V8.667h5.331v5.331zm4 0v1.336H8.001V8.667h5.334v5.332h-2.669v-.001zm12.001 0h-1.33v-4h-1.336v4h-1.335v-4h-1.33v4h-2.671V8.667h8.002v5.331zM10.665 10H12v2.667h-1.335V10z"/>
        </svg>
        <span class="docs-npm-label">npm</span>
      </a>
      <button id="theme-toggle" type="button" class="docs-theme-btn" aria-label="Toggle theme">
        <span class="docs-theme-icon" aria-hidden="true">◐</span>
        <span class="docs-theme-label">Theme</span>
      </button>
    </div>
  </nav>
</header>

<script>
  // Mega-menu toggle: CSS opens panels on :hover/:focus-within; this
  // script keeps aria-expanded honest and supports click + Escape +
  // outside-click for pointerless flows.
  const triggers = document.querySelectorAll<HTMLButtonElement>(".docs-mega-trigger");
  const closeAll = (except?: HTMLButtonElement) => {
    triggers.forEach((t) => {
      if (t !== except) t.setAttribute("aria-expanded", "false");
    });
  };
  for (const trigger of triggers) {
    trigger.addEventListener("click", () => {
      const open = trigger.getAttribute("aria-expanded") === "true";
      closeAll(trigger);
      trigger.setAttribute("aria-expanded", open ? "false" : "true");
    });
  }
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeAll();
  });
  document.addEventListener("click", (event) => {
    if (event.target instanceof Element && !event.target.closest(".docs-mega")) closeAll();
  });
</script>
