---
/**
  * SiteNav — top navigation with mega menus.
  *
  * Three dropdown triggers (Components, Blocks, Resources) open panels on
  * hover AND on click/Enter (button semantics), close on Escape and outside
  * click. Panels are real lists of anchor links; CSS :hover/:focus-within
  * opens them without JS, the toggle script only handles aria-expanded +
  * outside-click. Single links (Docs, Roadmap) stay plain anchors.
  */
import {SITE} from "../../lib/site";
import SearchPalette from "./SearchPalette.astro";

interface MenuLink {
  href: string;
  title: string;
  desc: string;
  /** Renders as the featured gradient banner */
  featured?: boolean;
}

interface MenuSection {
  label: string;
  links: MenuLink[];
}

interface Props {
  /** Path prefix used for active-link highlighting, e.g. "/components". */
  active?: string;
}

const {active = ""} = Astro.props;

const componentLinks: MenuSection[] = [
  {
    label: "Browse",
    links: [
      {
        href: "/components/",
        title: "All components",
        desc: "Full catalog by category",
        // Renders as the featured gradient banner.
        featured: true,
      },
      {href: "/components/#cat-general", title: "General", desc: "Button, Link, Kbd, Clipboard…"},
      {href: "/components/#cat-layout", title: "Layout", desc: "Card, Accordion, Separator…"},
      {href: "/components/#cat-navigation", title: "Navigation", desc: "Tabs, Pagination, Stepper…"},
      {href: "/components/#cat-forms", title: "Forms", desc: "Input, Select, Rating, Slider…"},
      {href: "/components/#cat-data-display", title: "Data display", desc: "Table, Badge, Avatar, Tag…"},
      {href: "/components/#cat-feedback", title: "Feedback", desc: "Alert, Spinner, Progress, Toast…"},
      {href: "/components/#cat-overlay", title: "Overlay", desc: "Dialog, Sheet, Popover, Tooltip…"},
    ],
  },
];

const popularLinks: MenuSection = {
  label: "Popular",
  links: [
    {href: "/components/button/", title: "Button", desc: "Variants, sizes, loading states"},
    {href: "/components/dialog/", title: "Dialog", desc: "Modal with native <dialog>"},
    {href: "/components/toast/", title: "Toast", desc: "Stacked notifications"},
    {href: "/components/select/", title: "Select", desc: "Native form control styling"},
    {href: "/components/tabs/", title: "Tabs", desc: "Keyboard-navigable panels"},
    {href: "/components/table/", title: "Table", desc: "Sortable, token-themed data"},
  ],
};

const blockLinks: MenuSection[] = [
  {
    label: "Composed blocks",
    links: [
      {href: "/blocks/", title: "All blocks", desc: "Sections built from components"},
      {href: "/blocks/application/", title: "Application", desc: "Settings, members, empty states, chat"},
      {href: "/blocks/social/", title: "Social", desc: "Social proof, avatar stacks"},
      {href: "/blocks/navigation/", title: "Navigation", desc: "Breadcrumbs"},
      {href: "/blocks/auth/", title: "Auth", desc: "Sign-in, sign-up, recovery"},
      {href: "/blocks/marketing/", title: "Marketing", desc: "Pricing, dashboards, stats, CTA"},
      {href: "/blocks/content/", title: "Content", desc: "FAQ, changelog entries"},
    ],
  },
];

const resourceLinks: MenuSection[] = [
  {
    label: "Learn",
    links: [
      {href: "/docs/", title: "Documentation", desc: "Guides: get started, styling, RTL"},
      {href: "/docs/get-started/", title: "Get started", desc: "Install and first component"},
      {href: "/docs/styling/", title: "Styling", desc: "Tokens and theming model"},
      {href: "/docs/rtl/", title: "RTL", desc: "Logical properties, mirroring"},
      {href: "/docs/changelog/", title: "Changelog", desc: "Release history"},
      {href: "/docs/releases/", title: "Releases", desc: "What shipped, by version"},
    ],
  },
  {
    label: "Project",
    links: [
      {href: "/docs/roadmap/", title: "Roadmap", desc: "What's next for the library"},
      {href: SITE.repo, title: "GitHub", desc: "Source, issues, discussions"},
    ],
  },
];

const menus = [
  {
    id: "components",
    label: "Components",
    match: "/components",
    // Two sections fill the panel's 2-column grid — a lone section leaves
    // the right column as blank white space.
    sections: [...componentLinks, popularLinks],
  },
  {id: "blocks", label: "Blocks", match: "/blocks", sections: blockLinks},
  {id: "docs", label: "Docs", match: "/docs", sections: resourceLinks},
];

/**
 * Icon per menu link, keyed by title (all titles are unique site-wide).
 * Values are the inner SVG markup for a 16×16 stroke icon; the wrapper
 * <svg> carries stroke/fill so each path stays a single `d`. Links whose
 * title has no entry simply render without an icon (safe fallback).
 */
const menuIcons: Record<string, string> = {
  "All components":
    '<path d="M2.5 2.5H7V7H2.5z" /><path d="M9 2.5h4.5V7H9z" /><path d="M2.5 9H7v4.5H2.5z" /><path d="M9 9h4.5v4.5H9z" />',
  General:
    '<path d="M8 1.8 14 5v6l-6 3.2L2 11V5z" /><path d="m2 5 6 3 6-3M8 8v6.2" />',
  Layout:
    '<rect x="2.5" y="2.5" width="11" height="11" rx="1.5" /><path d="M2.5 6.5h11M6.5 6.5v7" />',
  Navigation:
    '<circle cx="8" cy="8" r="5.5" /><path d="M10.5 5.5 9.2 9.2 5.5 10.5 6.8 6.8z" />',
  Forms:
    '<rect x="2" y="5" width="12" height="6" rx="1.5" /><path d="M5 8h3" />',
  "Data display":
    '<path d="M3 13.5V9M8 13.5V4.5M13 13.5V7" />',
  Feedback:
    '<path d="M13.5 8a5.5 5.5 0 0 1-8.1 4.8L2.5 13.5l.7-2.9A5.5 5.5 0 1 1 13.5 8z" />',
  Overlay:
    '<path d="M8 2 14 5 8 8 2 5z" /><path d="m2.5 8.5 5.5 3 5.5-3" />',
  Button:
    '<rect x="2" y="5.5" width="12" height="6" rx="3" /><circle cx="8" cy="8.5" r="1" />',
  Dialog:
    '<rect x="2" y="2.5" width="12" height="11" rx="1.5" /><path d="M2 5.5h12M4.2 4h.01" />',
  Toast:
    '<path d="M8 2a4 4 0 0 1 4 4v3l1.5 2.5h-11L4 9V6a4 4 0 0 1 4-4z" /><path d="M6.5 13.5a1.5 1.5 0 0 0 3 0" />',
  Select:
    '<rect x="2.5" y="2.5" width="11" height="11" rx="1.5" /><path d="m5.5 7 2.5 2.5L10.5 7" />',
  Tabs:
    '<path d="M2 5.5V4a1.5 1.5 0 0 1 1.5-1.5H6l1.5 2h5A1.5 1.5 0 0 1 14 6v6a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 12z" />',
  Table:
    '<rect x="2" y="2.5" width="12" height="11" rx="1.5" /><path d="M2 6.5h12M2 10.5h12M8 6.5v7" />',
  "All blocks":
    '<rect x="4.5" y="1.5" width="8" height="8" rx="1" /><rect x="2.5" y="6.5" width="8" height="8" rx="1" />',
  Application:
