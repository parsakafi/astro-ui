---
/**
  * DocsLayout — three-column docs shell (sidebar · content · toc).
  * Falls back to the centered single column for home/catalog.
  * Owns the global styles + theme toggle (demo-app behavior).
  */
import SiteNav from "../components/docs/SiteNav.astro";
import SiteFooter from "../components/docs/SiteFooter.astro";
import DocsSidebar from "../components/docs/DocsSidebar.astro";
import BlocksSidebar from "../components/docs/BlocksSidebar.astro";
import Toc from "../components/docs/Toc.astro";
import "@parsakafi/astro-ui/tokens.css";
import "@parsakafi/astro-ui/base.css";
// Toast styles ship globally: Toaster renders into fixed stacks on any
// page, and component-level CSS imports don't survive the static
// build — so this lives with the other global stylesheets.
import "@parsakafi/astro-ui/toast.css";
import "../styles/tailwind.css";
import "../styles/demo.css";
import "../styles/docs.css";
import "../styles/brand.css";
import {SITE} from "../lib/site";

interface Props {
  title: string;
  description?: string;
  /** Component slug for sidebar highlighting (detail pages). */
  slug?: string;
  /** Show the components sidebar (catalog + detail pages). */
  sidebar?: boolean;
  /** Show the blocks sidebar instead of the components one. */
  blocksSidebar?: boolean;
  /** Block id for blocks-sidebar highlighting (detail pages). */
  blockId?: string;
  /** Block category id for blocks-sidebar highlighting. */
  blockCategory?: string;
  /** Right-hand TOC entries. */
  toc?: { id: string; label: string }[];
  /** Nav active-match override (e.g. "blocks", "roadmap", "docs"). */
  activePath?: string;
}

const {
  title,
  description,
  slug,
  sidebar = false,
  blocksSidebar = false,
  blockId,
  blockCategory,
  toc,
  activePath = "docs",
} = Astro.props;

// Social/canonical metadata is derived per page so every route advertises
// itself: the origin comes from `site` in astro.config.mjs, the path from
// the build. `new URL()` normalises the trailing slash (Astro emits
// `/route/index.html`, so paths end in `/`).
const site = Astro.site ?? new URL("https://astroui.ir");
const origin = site.origin;
const canonical = new URL(Astro.url.pathname, site).href;
const socialTitle = `${title} · ${SITE.name}`;
const socialDescription = description ?? SITE.description;
const socialImage = new URL("/og.png", site).href;

// Site-level entities only — no per-page markup to keep crawlers from
// seeing 100 near-duplicate Page nodes. SoftwareApplication carries the
// package facts, WebSite the name/description used in sitelinks.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${origin}/#website`,
      url: `${origin}/`,
      name: SITE.name,
      alternateName: SITE.shortName,
      description: SITE.description,
      inLanguage: "en",
      publisher: {"@id": `${origin}/#software`},
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${origin}/#software`,
      name: SITE.name,
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Any",
      softwareVersion: SITE.version,
      description: SITE.description,
      url: `${origin}/`,
      codeRepository: SITE.repo,
      license: "https://opensource.org/licenses/MIT",
      offers: {"@type": "Offer", price: "0", priceCurrency: "USD"},
    },
  ],
};
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="description" content={socialDescription}/>
  <meta name="viewport" content="width=device-width"/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <meta name="generator" content={Astro.generator}/>
  <title>{socialTitle}</title>
  <link rel="canonical" href={canonical}/>
  <meta property="og:type" content="website"/>
  <meta property="og:site_name" content={SITE.name}/>
  <meta property="og:title" content={socialTitle}/>
  <meta property="og:description" content={socialDescription}/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:image" content={socialImage}/>
  <meta property="og:image:width" content="1200"/>
  <meta property="og:image:height" content="630"/>
  <meta property="og:image:alt" content={`${SITE.name} — ${SITE.description}`}/>
  <meta property="og:locale" content="en"/>
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content={socialTitle}/>
  <meta name="twitter:description" content={socialDescription}/>
  <meta name="twitter:image" content={socialImage}/>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}/>
  <script is:inline>
    // Theme init: runs before paint to avoid FOUC (demo-app behavior).
    try {
      const saved = localStorage.getItem("astroui-theme");
      document.documentElement.dataset.theme =
        saved === "light" || saved === "dark"
          ? saved
          : window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
    } catch {
      /* private mode — fall back to system preference */
      document.documentElement.dataset.theme = window.matchMedia(
        "(prefers-color-scheme: dark)",
      ).matches
        ? "dark"
        : "light";
    }
  </script>
</head>
<body>
<SiteNav active={sidebar || blocksSidebar ? (blocksSidebar ? "blocks" : "components") : activePath}/>

{
  blocksSidebar ? (
    <div class="docs-shell">
      <BlocksSidebar currentBlockId={blockId} currentCategoryId={blockCategory} isCatalog={!blockId && !blockCategory}/>
      <div class="docs-content-wrap">
        <main class="docs-main" id="main">
          <slot/>
        </main>
        <Toc items={toc ?? []}/>
      </div>
    </div>
  ) : sidebar ? (
    <div class="docs-shell">
      <DocsSidebar currentSlug={slug}/>
      <div class="docs-content-wrap">
        <main class="docs-main" id="main">
          <slot/>
        </main>
        <Toc items={toc ?? []}/>
      </div>
    </div>
  ) : toc && toc.length > 0 ? (
    <div class="docs-shell docs-shell--no-side">
      <div class="docs-content-wrap">
        <main class="docs-main" id="main">
          <slot/>
        </main>
        <Toc items={toc}/>
      </div>
    </div>
  ) : (
    <main class="docs-main docs-main--wide" id="main">
      <slot/>
    </main>
  )
}

<SiteFooter/>

<script>
  // Theme toggle: demo-app behavior (not library code).
  const btn = document.getElementById("theme-toggle");
  btn?.addEventListener("click", () => {
    const root = document.documentElement;
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("astroui-theme", next);
    } catch {
      /* ignore */
    }
  });
</script>
</body>
</html>
