---
/**
  * /docs/changelog/ — the single release history, in Keep a Changelog
  * format (docs-flavored: dense, factual). /docs/releases/ redirects here.
  */
import DocsLayout from "../../layouts/DocsLayout.astro";
import {parseChangelog, renderBullet} from "../../lib/changelog";
import {readFileSync} from "node:fs";
import {astroUiPath} from "../../lib/ui-path";

const changelogRaw = readFileSync(astroUiPath("CHANGELOG.md"), "utf8");
const entries = parseChangelog(changelogRaw);

const sectionIcons: Record<string, string> = {
  added: "✚",
  fixed: "◐",
  changed: "↻",
  deprecated: "⚠",
  removed: "✕",
  security: "🔒",
};

// Legend mirrors the sections that actually occur, so every icon used in
// the entries below is explained.
const legend = Object.entries(sectionIcons).filter(([key]) =>
  entries.some((e) => e.sections[key]?.length > 0),
);

// An empty `## [Unreleased]` heading in CHANGELOG.md should not become an
// empty card; it appears as soon as the first entry is written.
const visibleEntries = entries.filter(
  (entry) =>
    Object.values(entry.sections).reduce(
      (n, bullets) => n + bullets.length,
      0,
    ) > 0,
);
---

<DocsLayout title="Changelog" description="Full changelog for astro-ui." activePath="docs"
            toc={visibleEntries.map((e) => ({id: `v-${e.version}`, label: e.version}))}>
  <article class="docs-article docs-prose">
    <section id="overview" class="docs-hero">
      <p class="docs-hero-kicker">Docs · Reference</p>
      <h1>Changelog</h1>
      <p>
        All notable changes to astro-ui, following <a href="https://keepachangelog.com/en/1.0.0/" target="_blank"
                                                      rel="noreferrer noopener">Keep a Changelog</a>.
        The source of truth is <code>astro-ui/CHANGELOG.md</code>.
      </p>
    </section>

    <nav class="docs-release-legend" aria-label="Change type legend">
      {
        legend.map(([key, icon]) => (
          <span class="docs-release-legend-item">
            <span class="docs-release-icon" aria-hidden="true">{icon}</span>
            {key.charAt(0).toUpperCase() + key.slice(1)}
          </span>
        ))
      }
    </nav>

    <section>
      {
        visibleEntries.map((entry) => (
          <article class="docs-release" id={`v-${entry.version}`}>
            <header class="docs-release-head">
              <span class="docs-release-version">v{entry.version}</span>
              {entry.date && <span class="docs-release-date">{entry.date}</span>}
            </header>
            {Object.entries(entry.sections).map(([section, bullets]) => (
              <div class="docs-release-section">
                <p class="docs-release-section-title">
									<span class="docs-release-icon" aria-hidden="true">
										{sectionIcons[section] ?? "•"}
									</span>
                  {section.charAt(0).toUpperCase() + section.slice(1)}
                </p>
                <ul>
                  {bullets.map((bullet) => (
                    <li set:html={renderBullet(bullet)}/>
                  ))}
                </ul>
              </div>
            ))}
          </article>
        ))
      }
    </section>
  </article>
</DocsLayout>
