{
  "name": "astroui-web",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "stop": "astro dev stop",
    "css": "sass src/styles:src/styles --no-source-map",
    "css:watch": "sass --watch src/styles:src/styles --no-source-map",
    "build": "npm run css && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "audit:render": "npx tsx scripts/audit-render.ts",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/e2e/visual.spec.ts --project=chromium",
    "test:visual:update": "playwright test tests/e2e/visual.spec.ts --project=chromium --update-snapshots"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.3.3",
    "astro-ui": "file:..",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "sass": "^1.105.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.0.13",
    "vitest": "^5.0.3"
  }
}
