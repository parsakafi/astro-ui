{
  "name": "astro-ui",
  "description": "Astro-first, zero-JS-by-default, accessible UI component library with semantic design tokens.",
  "homepage": "https://astroui.ir",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parsakafi/astro-ui-component-library.git"
  },
  "bugs": {
    "url": "https://github.com/parsakafi/astro-ui-component-library/issues"
  },
  "version": "0.1.0",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "web"
  ],
  "exports": {
    ".": "./index.ts",
    "./tokens.css": "./src/styles/tokens.css",
    "./base.css": "./src/styles/base.css",
    "./link": "./src/components/general/Link.astro",
    "./accordion": "./src/components/layout/Accordion.astro",
    "./alert-dialog": "./src/components/overlay/AlertDialog.astro",
    "./aspect-ratio": "./src/components/layout/AspectRatio.astro",
    "./attachment": "./src/components/data-display/Attachment.astro",
    "./autocomplete": "./src/components/forms/Autocomplete.astro",
    "./combobox": "./src/components/forms/Combobox.astro",
    "./date-picker": "./src/components/forms/DatePicker.astro",
    "./time-picker": "./src/components/forms/TimePicker.astro",
    "./breadcrumb": "./src/components/navigation/Breadcrumb.astro",
    "./clipboard": "./src/components/general/Clipboard.astro",
    "./command": "./src/components/general/Command.astro",
    "./collapsible": "./src/components/layout/Collapsible.astro",
    "./empty": "./src/components/data-display/Empty.astro",
    "./field": "./src/components/forms/Field.astro",
    "./hover-card": "./src/components/overlay/HoverCard.astro",
    "./kbd": "./src/components/general/Kbd.astro",
    "./pagination": "./src/components/navigation/Pagination.astro",
    "./navbar": "./src/components/navigation/Navbar.astro",
    "./sidebar": "./src/components/navigation/Sidebar.astro",
    "./sidebar-group": "./src/components/navigation/SidebarGroup.astro",
    "./sidebar-item": "./src/components/navigation/SidebarItem.astro",
    "./popover": "./src/components/overlay/Popover.astro",
    "./menu": "./src/components/overlay/Menu.astro",
    "./menu-item": "./src/components/overlay/MenuItem.astro",
    "./menu-group": "./src/components/overlay/MenuGroup.astro",
    "./menu-separator": "./src/components/overlay/MenuSeparator.astro",
    "./rating": "./src/components/forms/Rating.astro",
    "./scroll-area": "./src/components/layout/ScrollArea.astro",
    "./slider": "./src/components/forms/Slider.astro",
    "./sheet": "./src/components/overlay/Sheet.astro",
    "./stepper": "./src/components/navigation/Stepper.astro",
    "./tree": "./src/components/navigation/Tree.astro",
    "./tree-item": "./src/components/navigation/TreeItem.astro",
    "./sticky-surface": "./src/components/layout/StickySurface.astro",
    "./tag": "./src/components/data-display/Tag.astro",
    "./lightbox": "./src/components/overlay/Lightbox.astro",
    "./lightbox-item": "./src/components/overlay/LightboxItem.astro",
    "./tooltip": "./src/components/overlay/Tooltip.astro",
    "./button": "./src/components/general/Button.astro",
    "./carousel": "./src/components/general/Carousel.astro",
    "./carousel-slide": "./src/components/general/CarouselSlide.astro",
    "./button-group": "./src/components/general/ButtonGroup.astro",
    "./button-group-text": "./src/components/general/ButtonGroupText.astro",
    "./button-group-separator": "./src/components/general/ButtonGroupSeparator.astro",
    "./badge": "./src/components/data-display/Badge.astro",
    "./before-after": "./src/components/data-display/BeforeAfter.astro",
    "./card": "./src/components/layout/Card.astro",
    "./avatar": "./src/components/data-display/Avatar.astro",
    "./avatar-group": "./src/components/data-display/AvatarGroup.astro",
    "./bubble": "./src/components/data-display/Bubble.astro",
    "./chart": "./src/components/data-display/Chart.astro",
    "./bubble-content": "./src/components/data-display/BubbleContent.astro",
    "./bubble-group": "./src/components/data-display/BubbleGroup.astro",
    "./bubble-reactions": "./src/components/data-display/BubbleReactions.astro",
    "./alert": "./src/components/feedback/Alert.astro",
    "./banner": "./src/components/feedback/Banner.astro",
    "./notification-center": "./src/components/feedback/NotificationCenter.astro",
    "./notification-group": "./src/components/feedback/NotificationGroup.astro",
    "./notification-item": "./src/components/feedback/NotificationItem.astro",
    "./timeline": "./src/components/data-display/Timeline.astro",
    "./timeline-item": "./src/components/data-display/TimelineItem.astro",
    "./spinner": "./src/components/feedback/Spinner.astro",
    "./skeleton": "./src/components/feedback/Skeleton.astro",
    "./separator": "./src/components/layout/Separator.astro",
    "./select": "./src/components/forms/Select.astro",
    "./input": "./src/components/forms/Input.astro",
    "./input-group": "./src/components/forms/InputGroup.astro",
    "./label": "./src/components/forms/Label.astro",
    "./checkbox": "./src/components/forms/Checkbox.astro",
    "./dialog": "./src/components/overlay/Dialog.astro",
    "./radio": "./src/components/forms/Radio.astro",
    "./radio-group": "./src/components/forms/RadioGroup.astro",
    "./switch": "./src/components/forms/Switch.astro",
    "./textarea": "./src/components/forms/Textarea.astro",
    "./table": "./src/components/data-display/Table.astro",
    "./tabs": "./src/components/navigation/Tabs.astro",
    "./toggle": "./src/components/forms/Toggle.astro",
    "./toggle-group": "./src/components/forms/ToggleGroup.astro",
    "./toaster": "./src/components/feedback/Toaster.astro",
    "./toast": {
      "module": "./src/utils/toast.ts",
      "browser": "./src/utils/toast.ts",
      "development": "./src/utils/toast.ts",
      "astro": "./src/utils/toast.ts",
      "import": "./src/utils/toast.ts",
      "default": "./src/utils/toast.ts"
    },
    "./toast.css": "./src/styles/toast.css",
    "./utils": "./src/utils/cn.ts"
  },
  "files": [
    "src",
    "!src/content",
    "!src/pages",
    "index.ts"
  ],
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "astro",
    "astro-component",
    "ui",
    "design-system",
    "accessible",
    "zero-js"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=astroui-web",
    "build": "turbo run build --filter=astroui-web",
    "check": "astro check && turbo run check --filter=astroui-web",
    "test": "vitest run && turbo run test --filter=astroui-web",
    "test:watch": "vitest",
    "lint": "biome check src tests index.ts && eslint . --max-warnings 0",
    "format": "biome check --write src tests index.ts",
    "build:css": "sass src/styles-scss/toast.scss src/styles/toast.css --quiet --no-source-map",
    "watch:css": "sass src/styles-scss/toast.scss src/styles/toast.css --quiet --no-source-map --watch",
    "prepublishOnly": "npm run build:css && npx astro check && npx biome check src tests index.ts && npx vitest run"
  },
  "peerDependencies": {
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.1",
    "astro": "^7.3.3",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.12.0",
    "sass": "^1.89.0",
    "turbo": "^2.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
