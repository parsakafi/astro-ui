---
import { resolveAriaLabel } from "../../utils/a11y";
/**
 * Input — zero-JS text control.
 *
 * Native <input> with token-driven states (focus ring, invalid,
 * disabled, readonly). Compose with Label + hint/error text; wire them
 * with `id` / `aria-describedby`:
 *
 *   <Label for="email">Email</Label>
 *   <Input id="email" type="email" aria-describedby="email-hint" />
 *   <p id="email-hint">We never share your email.</p>
 *
 * Validation display is server/form-driven via `invalid` — no JS shipped.
 *
 * JavaScript required: No
 */
import { cn } from "../../utils/cn";

export interface Props {
  /**
   * Constrained to valid HTML input types (assignable to the native attribute).
   */
  type?:
    | "text"
    | "email"
    | "password"
    | "number"
    | "search"
    | "tel"
    | "url"
    | "date"
    | "time"
    | "datetime-local"
    | "month"
    | "week"
    | "color"
    | "file"
    | "range"
    | "hidden";
  name?: string;
  value?: string | number;
  placeholder?: string;
  /** Numeric/date bounds — native `min`/`max`/`step`. */
  min?: string | number;
  max?: string | number;
  step?: string | number;
  minlength?: number;
  maxlength?: number;
  /** Native `accept` (file), `autocomplete`, `pattern`, `list` (datalist id). */
  accept?: string;
  autocomplete?: string;
  pattern?: string;
  list?: string;
  multiple?: boolean;
  required?: boolean;
  disabled?: boolean;
  readonly?: boolean;
  invalid?: boolean;
  size?: "xs" | "sm" | "md" | "lg" | "xl";
  variant?:
    | "inherit"
    | "primary"
    | "secondary"
    | "muted"
    | "error"
    | "success"
    | "warning"
    | "info";
  class?: string;
  id?: string;
  ariaLabel?: string;
  ariaDescribedby?: string;
  /** Inline styles forwarded to the native <input> control. */
  style?: string;
}

const {
  type = "text",
  name,
  value,
  placeholder,
  min,
  max,
  step,
  minlength,
  maxlength,
  accept,
  autocomplete,
  pattern,
  list,
  multiple = false,
  required = false,
  disabled = false,
  readonly = false,
  invalid = false,
  size = "md",
  variant = "inherit",
  class: className,
  id,
  ariaLabel,
  ariaDescribedby,
  style,
  ...rest
} = Astro.props;

const classes = cn(
  "aui-input",
  `aui-input--${size}`,
  `aui-input--variant-${variant}`,
  invalid && "aui-input--invalid",
  className,
);
---

<input
  class={classes}
  style={style}
  type={type}
  name={name}
  value={value}
  placeholder={placeholder}
  min={min}
  max={max}
  step={step}
  minlength={minlength}
  maxlength={maxlength}
  accept={accept}
  autocomplete={autocomplete}
  pattern={pattern}
  list={list}
  multiple={multiple || undefined}
  required={required || undefined}
  disabled={disabled || undefined}
  readonly={readonly || undefined}
  aria-invalid={invalid || undefined}
  aria-label={resolveAriaLabel(Astro.props, ariaLabel)}
  aria-describedby={ariaDescribedby}
  id={id}
  {...rest}
/>

<style>
  .aui-input {
    display: flex;
    width: 100%;
    font-family: var(--ui-font-sans);
    font-size: var(--ui-text-sm);
    line-height: var(--ui-leading-normal);
    color: var(--ui-foreground);
    background-color: var(--ui-background);
    border: 1px solid var(--ui-input);
    border-radius: var(--ui-control-radius);
    transition: border-color var(--ui-transition-fast),
    outline-color var(--ui-transition-fast);
  }

  .aui-input::placeholder {
    color: var(--ui-muted-foreground);
  }

  /* --- size --- */

  .aui-input--xs {
    height: var(--ui-control-height-xs);
    padding: 0 var(--ui-control-padding-xs);
    font-size: var(--ui-text-2xs);
  }

  .aui-input--sm {
    height: var(--ui-control-height-sm);
    padding: 0 var(--ui-control-padding-sm);
    font-size: var(--ui-text-xs);
  }

  .aui-input--md {
    height: var(--ui-control-height-md);
    padding: 0 var(--ui-control-padding-md);
  }

  .aui-input--lg {
    height: var(--ui-control-height-lg);
    padding: 0 var(--ui-control-padding-lg);
    font-size: var(--ui-text-base);
  }

  .aui-input--xl {
    height: var(--ui-control-height-xl);
    padding: 0 var(--ui-control-padding-xl);
    font-size: var(--ui-text-lg);
  }

  /* --- variant borders --- */

  .aui-input--variant-inherit {
    border-color: inherit;
  }

  .aui-input--variant-primary {
    border-color: var(--ui-primary);
  }

  .aui-input--variant-secondary {
    border-color: var(--ui-secondary);
  }

  .aui-input--variant-muted {
    border-color: var(--ui-muted-foreground);
  }

  .aui-input--variant-error {
    border-color: var(--ui-error);
  }

  .aui-input--variant-success {
    border-color: var(--ui-success);
  }

  .aui-input--variant-warning {
    border-color: var(--ui-warning);
  }

  .aui-input--variant-info {
    border-color: var(--ui-info);
  }

  .aui-input:focus-visible {
    border-color: var(--ui-ring);
    outline: var(--ui-focus-ring-width) solid var(--ui-ring);
    outline-offset: var(--ui-focus-ring-offset);
  }

  /* Invalid overrides the border + focus ring */
  .aui-input--invalid {
    border-color: var(--ui-error);
  }

  .aui-input--invalid:focus-visible {
    border-color: var(--ui-error);
    outline-color: var(--ui-error);
  }

  .aui-input:disabled {
    opacity: var(--ui-disabled-opacity);
    cursor: not-allowed;
    background-color: var(--ui-muted);
  }

  .aui-input[readonly] {
    background-color: var(--ui-muted);
  }
</style>
