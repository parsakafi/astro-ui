---
/**
  * Stepper — ordered progress indicator, zero JS.
  *
  * A semantic <ol> of steps (including hidden step names for screen
  * readers via visually-hidden text). Steps are display-only by
  * default — wire navigation app-side if steps are links by passing
  * hrefs per item. States: complete (✓), current, upcoming, disabled.
  *
  * JavaScript required: No
  */
import {cn} from "../../utils/cn";

export interface StepperItem {
  /** Visible step label. */
  label: string;
  /** Optional supporting text under the label. */
  description?: string;
  /** Marks the step done (✓). */
  complete?: boolean;
  /** Marks the active step. */
  current?: boolean;
  /** Disables the step visually. */
  disabled?: boolean;
  /** When set, the label renders as a link to this step. */
  href?: string;
}

export interface Props {
  /** Steps in display order. */
  items: StepperItem[];
  /** Layout direction. */
  orientation?: "horizontal" | "vertical";
  /** Visual style of the connectors. */
  variant?: "line" | "dots";
  /** Scale of labels and markers. */
  size?: "sm" | "md" | "lg";
  /** Accessible name for the group. */
  ariaLabel?: string;
  class?: string;
  id?: string;
}

const {
  items,
  orientation = "horizontal",
  variant = "line",
  size = "md",
  ariaLabel = "Progress",
  class: className,
  id,
  ...rest
} = Astro.props;

const classes = cn(
  "aui-stepper",
  `aui-stepper--${orientation}`,
  `aui-stepper--${variant}`,
  `aui-stepper--${size}`,
  className,
);
---

<ol id={id} class={classes} aria-label={ariaLabel} {...rest}>
  {
    items.map((item, index) => {
      const state = item.complete ? "complete" : item.current ? "current" : item.disabled ? "disabled" : "upcoming";
      const marker = item.complete ? "✓" : index + 1;
      const label = (
        <span class="aui-stepper__label">
					{item.label}
          {item.description && <span class="aui-stepper__description">{item.description}</span>}
				</span>
      );
      return (
        <li class="aui-stepper__item" data-state={state} aria-current={item.current ? "step" : undefined}>
					<span class="aui-stepper__marker" aria-hidden="true">
						{marker}
					</span>
          {item.href && !item.disabled ? (
            <a class="aui-stepper__link" href={item.href}>
              {label}
            </a>
          ) : (
            label
          )}
        </li>
      );
    })
  }
</ol>

<style>
  .aui-stepper {
    display: flex;
    margin: 0;
    padding: 0;
    font-family: var(--ui-font-sans);
    list-style: none;
  }

  .aui-stepper--horizontal {
    flex-direction: row;
    align-items: flex-start;
  }

  .aui-stepper--vertical {
    flex-direction: column;
    gap: var(--ui-space-4);
  }

  /* --- item & connector --- */

  .aui-stepper__item {
    display: flex;
    /* Top-align so every marker shares one row (first label line),
       even when a step has a multi-line description. */
    align-items: flex-start;
    gap: var(--ui-space-2);
    position: relative;
    flex: 1;
  }

  .aui-stepper--vertical .aui-stepper__item {
    flex: none;
    align-items: flex-start;
  }

  /* horizontal connector: pseudo-element line after each item except last */
  .aui-stepper--horizontal .aui-stepper__item:not(:last-child)::after {
    content: "";
    flex: 1;
    height: 1px;
    margin-inline: var(--ui-space-2);
    background-color: var(--ui-border);
    /* Pin to the marker's centerline (marker height / 2), since
       items are top-aligned and can differ in height. */
    align-self: flex-start;
    margin-block-start: 0.75rem;
  }

  .aui-stepper--horizontal.aui-stepper--sm .aui-stepper__item:not(:last-child)::after {
    margin-block-start: 0.625rem;
  }

  .aui-stepper--horizontal.aui-stepper--lg .aui-stepper__item:not(:last-child)::after {
    margin-block-start: 1rem;
  }

  .aui-stepper--horizontal.aui-stepper--dots .aui-stepper__item:not(:last-child)::after {
    height: 2px;
    border-radius: var(--ui-radius-full);
  }

  .aui-stepper__item[data-state="complete"]::after {
    background-color: var(--ui-primary);
  }

  /* vertical connector */
  .aui-stepper--vertical .aui-stepper__item:not(:last-child)::after {
    content: "";
    position: absolute;
    inset-block-start: calc(1.5rem + var(--ui-space-1));
    inset-inline-start: 0.75rem;
    width: 1px;
    height: calc(100% - 1.5rem);
    background-color: var(--ui-border);
  }

  .aui-stepper--vertical.aui-stepper--sm .aui-stepper__item:not(:last-child)::after {
    inset-block-start: calc(1.25rem + var(--ui-space-1));
    inset-inline-start: 0.625rem;
    height: calc(100% - 1.25rem);
  }

  .aui-stepper--vertical.aui-stepper--lg .aui-stepper__item:not(:last-child)::after {
    inset-block-start: calc(2rem + var(--ui-space-1));
    inset-inline-start: 1rem;
    height: calc(100% - 2rem);
  }

  /* --- marker --- */

  .aui-stepper__marker {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-weight: var(--ui-font-semibold);
    border: 1px solid var(--ui-border);
    border-radius: var(--ui-radius-full);
    background-color: var(--ui-background);
    color: var(--ui-muted-foreground);
    font-variant-numeric: tabular-nums;
  }

  .aui-stepper--sm .aui-stepper__marker {
    width: 1.25rem;
    height: 1.25rem;
    font-size: var(--ui-text-2xs);
  }

  .aui-stepper--md .aui-stepper__marker {
    width: 1.5rem;
    height: 1.5rem;
    font-size: var(--ui-text-xs);
  }

  .aui-stepper--lg .aui-stepper__marker {
    width: 2rem;
    height: 2rem;
    font-size: var(--ui-text-sm);
  }

  .aui-stepper__item[data-state="current"] .aui-stepper__marker {
    color: var(--ui-primary-foreground);
    background-color: var(--ui-primary);
    border-color: var(--ui-primary);
  }

  .aui-stepper__item[data-state="complete"] .aui-stepper__marker {
    color: var(--ui-success-foreground);
    background-color: var(--ui-success);
    border-color: var(--ui-success);
  }

  .aui-stepper__item[data-state="disabled"] .aui-stepper__marker {
    opacity: var(--ui-disabled-opacity);
  }

  /* --- labels --- */

  .aui-stepper__label {
    display: grid;
    color: var(--ui-muted-foreground);
  }

  .aui-stepper__item[data-state="current"] .aui-stepper__label {
    color: var(--ui-foreground);
    font-weight: var(--ui-font-medium);
  }

  .aui-stepper__item[data-state="disabled"] .aui-stepper__label {
    opacity: var(--ui-disabled-opacity);
  }

  .aui-stepper--sm .aui-stepper__label {
    font-size: var(--ui-text-xs);
  }

  .aui-stepper--md .aui-stepper__label {
    font-size: var(--ui-text-sm);
  }

  .aui-stepper--lg .aui-stepper__label {
    font-size: var(--ui-text-base);
  }

  .aui-stepper__description {
    color: var(--ui-muted-foreground);
    font-weight: var(--ui-font-normal);
    font-size: var(--ui-text-xs);
  }

  .aui-stepper__link {
    color: inherit;
    text-decoration: none;
  }

  .aui-stepper__link:hover .aui-stepper__label {
    color: var(--ui-foreground);
    text-decoration: underline;
  }

  .aui-stepper__link:focus-visible {
    outline: var(--ui-focus-ring-width) solid var(--ui-ring);
    outline-offset: var(--ui-focus-ring-offset);
    border-radius: var(--ui-radius-sm);
  }
</style>
