  {
    zoomable && isMap && map && (
      <div class="aui-chart__zoombar">
        <button type="button" class="aui-chart__zoombtn" data-aui-zoom="in" aria-label="Zoom in">+</button>
        <button type="button" class="aui-chart__zoombtn" data-aui-zoom="out" aria-label="Zoom out">−</button>
        <button type="button" class="aui-chart__zoombtn" data-aui-zoom="reset" aria-label="Reset view">Reset</button>
      </div>
    )
  }

  {
    isSankey && sankey && (
      <svg
        class="aui-chart__svg"
        viewBox={`0 0 ${W} ${height}`}
        role="img"
        aria-label={`${tableCaption}: ${nodes.length} nodes, ${links.length} flows`}
        preserveAspectRatio="xMidYMid meet"
      >
        <defs>
          {sankeyLinks.map((l, i) => (
            <linearGradient id={`${uid}-sk-${i}`} x1="0" y1="0" x2="1" y2="0" gradientUnits="objectBoundingBox">
              <stop offset="0%" style={`stop-color: ${sankey.geo.get(l.source)!.color}; stop-opacity: 0.45`}/>
              <stop offset="100%" style={`stop-color: ${sankey.geo.get(l.target)!.color}; stop-opacity: 0.45`}/>
            </linearGradient>
          ))}
        </defs>
        {sankeyLinks.map((l, i) => (
          <path class="aui-chart__slink" d={l.d} fill={`url(#${uid}-sk-${i})`}>
            <title>{`${l.source} → ${l.target}: ${format(l.value)}`}</title>
          </path>
        ))}
        {sankeyNodes.map((n) => {
          /* Sources (first column) label left of their bar; every
             interior/target node labels right, like the reference. */
          const left = n.x <= 102;
          const lx = left ? n.x - 8 : n.x + sankey.nodeW + 8;
          const anchor = left ? "end" : "start";
          return (
            <g class="aui-chart__snode">
              <rect x={n.x} y={n.y} width={sankey.nodeW} height={n.h} rx={3} fill={n.color}>
                <title>{`${n.name}: ${format(n.v)}`}</title>
              </rect>
              <text class="aui-chart__snode-name" x={lx} y={n.y + n.h / 2 - 1} text-anchor={anchor}>
                {n.name}
              </text>
              <text class="aui-chart__snode-value" x={lx} y={n.y + n.h / 2 + 15} text-anchor={anchor}>
                {format(n.v)}
              </text>
            </g>
          );
        })}
      </svg>
    )
  }

  {
    isRadar && (
      <svg
        class="aui-chart__svg"
        viewBox={`0 0 ${W} ${height}`}
        role="img"
        aria-label={`${tableCaption}: ${series.map((s) => s.name).join(", ")}`}
        preserveAspectRatio="xMidYMid meet"
      >
        <g class="aui-chart__radar-grid" aria-hidden="true">
          {radarRings.map((r) => (
            <path d={r.d}/>
          ))}
          {radarSpokes.map((d) => (
            <path d={d}/>
          ))}
        </g>
        {radarAxisLabels.map((l) => (
          <text class="aui-chart__tick" x={l.x} y={l.y} text-anchor={l.anchor}>
            {l.label}
          </text>
        ))}
        {radarSeries.map((s) => (
          <g class="aui-chart__radar-poly" style={`color: ${s.color}`}>
            <path d={s.poly}/>
            {s.dots.map((d) => (
              <circle class="aui-chart__dot" cx={d.x} cy={d.y} r={3}>
                <title>{d.tip}</title>
              </circle>
            ))}
          </g>
        ))}
      </svg>
    )
  }

  {
    isGauge && (
      <svg
        class="aui-chart__svg"
        viewBox={`0 0 ${W} ${height}`}
        role="img"
        aria-label={`${tableCaption}: ${format(gaugeValue)} of ${format(gaugeMax)}`}
        preserveAspectRatio="xMidYMid meet"
      >
        {gaugeIsBlock
          ? gaugeBlocks.map((b) => (
              <path
                class={`aui-chart__gblock${b.filled ? "" : " aui-chart__gblock--rest"}`}
                d={b.d}
                style={b.filled ? `stroke: ${b.color ?? colorAt(0, series[0])}` : undefined}
              />
            ))
          : gaugeLines.map((t) => (
              <path
                class={`aui-chart__gtick${t.filled ? "" : " aui-chart__gtick--rest"}`}
                d={t.d}
                style={t.filled ? `stroke: ${colorAt(0, series[0])}` : undefined}
              />
            ))}
        <text class="aui-chart__gauge-value" x={gcx} y={gcy - gR1 * 0.55} text-anchor="middle">
          {format(gaugeValue)}
        </text>
        {series[0]?.name && (
          <text class="aui-chart__gauge-label" x={gcx} y={gcy - gR1 * 0.55 + 26} text-anchor="middle">
            {series[0].name}
          </text>
        )}
      </svg>
    )
  }

    {
    legend && !isGauge && !isSankey && !isHeatmap && !isCohort && !isTerrain && !isMap && !isBullet && (
      <ul class="aui-chart__legend" aria-hidden="true">
        {isWaterfall ? (
          ["Increase", "Decrease", "Total"].map((name, i) => (
            <li>
              <span class="aui-chart__swatch" style={`background: ${waterfallColors[i]}`}/>
              {name}
            </li>
          ))
        ) : circular || isRadial || isPie3d ? (
          (circular
            ? pieData.map((d) => (
              <li>
                <span class="aui-chart__swatch" style={`background: ${d.color}`}/>
                {d.label}
              </li>
            ))
            : isRadial
              ? radialRings.map((r) => (
                <li>
                  <span class="aui-chart__swatch" style={`background: ${r.color}`}/>
                  {r.label}
                </li>
              ))
              : (pie3d?.slices ?? []).map((d) => (
                <li>
                  <span class="aui-chart__swatch" style={`background: ${d.color}`}/>
                  {d.label}
                </li>
              )))
        ) : isBoxplot ? (
          boxLegend.map((e) => (
            <li>
              <span class="aui-chart__swatch" style={`background: ${e.color}`}/>
              {e.label}
            </li>
          ))
        ) : isTreemap ? (
          (treemap?.tiles ?? []).map((t) => (
            <li>
              <span class="aui-chart__swatch" style={`background: ${t.color}`}/>
              {t.label}
            </li>
          ))
        ) : isFunnel || isRose || isWaffle ? (
          ((isFunnel ? funnel?.stages : isRose ? rose?.slices : waffle?.groups) ?? []).map((d) => (
            <li>
              <span class="aui-chart__swatch" style={`background: ${d.color}`}/>
              {d.label}
            </li>
          ))
        ) : (
          series.map((s, i) => (
            <li>
              <span class="aui-chart__swatch" style={`background: ${colorAt(i, s)}`}/>
              {s.name}
            </li>
          ))
        )}
      </ul>
    )
  }

  {zoomable && isMap && map && (
    <script define:vars={{chartId: uid, chartH: height}}>
      /* Zoom/pan drives the SVG viewBox directly — no re-render, no
         library. Buttons zoom about the viewport center; the wheel
         zooms toward the cursor; drag pans. Clamped to 1/6–2x so
         the view can't get lost. */
      const root = document.getElementById(chartId);
      const svg = root?.querySelector("svg.aui-chart__svg");
      const VB = {x: 0, y: 0, w: 640, h: chartH};
      let view = Object.assign({}, VB);
      const apply = () => svg?.setAttribute("viewBox", view.x + " " + view.y + " " + view.w + " " + view.h);
      const clamp = () => {
        view.w = Math.min(Math.max(view.w, VB.w / 6), VB.w * 2);
        view.h = Math.min(Math.max(view.h, VB.h / 6), VB.h * 2);
        view.x = Math.min(Math.max(view.x, VB.x - view.w / 2), VB.x + VB.w - view.w / 2);
        view.y = Math.min(Math.max(view.y, VB.y - view.h / 2), VB.y + VB.h - view.h / 2);
      };
      const zoomTo = (f, cx, cy) => {
        const nw = view.w * f;
        const nh = view.h * f;
        view.x = cx - (cx - view.x) * (nw / view.w);
        view.y = cy - (cy - view.y) * (nh / view.h);
        view.w = nw;
        view.h = nh;
        clamp();
        apply();
      };
      root?.querySelectorAll("[data-aui-zoom]").forEach((btn) =>
        btn.addEventListener("click", () => {
          const k = btn.getAttribute("data-aui-zoom");
          if (k === "reset") {
            view = Object.assign({}, VB);
            apply();
          } else {
            zoomTo(k === "in" ? 1 / 1.4 : 1.4, view.x + view.w / 2, view.y + view.h / 2);
          }
        }));
      let drag = null;
      svg?.addEventListener("pointerdown", (e) => {
        drag = {x: e.clientX, y: e.clientY, vx: view.x, vy: view.y};
        svg.setPointerCapture(e.pointerId);
      });
      svg?.addEventListener("pointermove", (e) => {
        if (!drag) return;
        const r = svg.getBoundingClientRect();
        view.x = drag.vx - ((e.clientX - drag.x) / r.width) * view.w;
        view.y = drag.vy - ((e.clientY - drag.y) / r.height) * view.h;
        clamp();
        apply();
      });
      svg?.addEventListener("pointerup", () => (drag = null));
      svg?.addEventListener("wheel", (e) => {
        e.preventDefault();
        const r = svg.getBoundingClientRect();
        zoomTo(e.deltaY < 0 ? 1 / 1.15 : 1.15,
          view.x + ((e.clientX - r.left) / r.width) * view.w,
          view.y + ((e.clientY - r.top) / r.height) * view.h);
      }, {passive: false});
    </script>
  )}

  {/* Screen-reader table — the visual is aria-labeled, this carries the data. */}
  {isBoxplot && boxData ? (
  <table class="aui-chart__table">
    <thead>
    <tr>
      <th scope="col">Category</th>
      {boxData.grouped && <th scope="col">Group</th>}
      <th scope="col">Min</th>
      <th scope="col">Q1</th>
      <th scope="col">Median</th>
      <th scope="col">Q3</th>
      <th scope="col">Max</th>
    </tr>
    </thead>
    <tbody>
    {boxData.boxes.map((r) => (
      <tr>
        <th scope="row">{r.cat}</th>
        {boxData.grouped && <td>{r.group}</td>}
        <td>{format(r.stats.min)}</td>
        <td>{format(r.stats.q1)}</td>
        <td>{format(r.stats.median)}</td>
        <td>{format(r.stats.q3)}</td>
        <td>{format(r.stats.max)}</td>
      </tr>
    ))}
    </tbody>
  </table>
  ) : isHistogram && histogram ? (
  <table class="aui-chart__table">
    <thead>
    <tr>
      <th scope="col">Bin</th>
      <th scope="col">Count</th>
    </tr>
    </thead>
    <tbody>
    {histogram.counts.map((c, i) => (
      <tr>
        <th scope="row">{format(histogram.edges[i])}–{format(histogram.edges[i + 1])}</th>
        <td>{c}</td>
      </tr>
    ))}
    </tbody>
  </table>
  ) : isBullet && bullet ? (
  <table class="aui-chart__table">
    <thead>
    <tr>
      <th scope="col">Measure</th>
      <th scope="col">Ranges</th>
      <th scope="col">Actual</th>
      <th scope="col">Target</th>
    </tr>
    </thead>
    <tbody>
    {bullet.lanes.map((l) => (
      <tr>
        <th scope="row">{l.label}</th>
        <td>{l.ranges.map(format).join(" / ")}</td>
        <td>{format(l.measure)}</td>
        <td>{l.target != null ? format(l.target) : "—"}</td>
      </tr>
    ))}
    </tbody>
  </table>
  ) : (
  <table class="aui-chart__table">
    <thead>
    <tr>
      <th scope="col">Category</th>
      {series.map((s) => (
        <th scope="col">{s.name}</th>
      ))}
    </tr>
    </thead>
    <tbody>
    {labels.map((label, i) => (
      <tr>
        <th scope="row">{label}</th>
        {series.map((s) => (
          <td>{format(s.data[i] ?? 0)}</td>
        ))}
      </tr>
    ))}
    </tbody>
  </table>
  )}
</figure>

<style>
  .aui-chart {
    display: grid;
    gap: var(--ui-space-2);
    /* Stretch to the container even inside flex/grid previews —
       charts must own the full width or hbar tracks collapse. */
    inline-size: 100%;
    min-inline-size: 0;
    font-family: var(--ui-font-sans);
    /* Anchor for the zoomable map's absolute toolbar. */
    position: relative;
  }

  .aui-chart__head {
    display: grid;
    gap: 2px;
  }

  .aui-chart__title {
    color: var(--ui-foreground);
    font-size: var(--ui-text-md);
    font-weight: var(--ui-font-semibold);
  }

  .aui-chart__desc {
    color: var(--ui-muted-foreground);
    font-size: var(--ui-text-sm);
  }

  .aui-chart__svg {
    inline-size: 100%;
    block-size: auto;
  }

  /* --- shared strokes --- */

  .aui-chart__grid line {
    stroke: var(--ui-border);
    stroke-width: 1;
    stroke-dasharray: 3 4;
  }

  .aui-chart__tick {
    fill: var(--ui-muted-foreground);
    font-size: 11px;
    font-family: var(--ui-font-sans);
  }

  .aui-chart__bar {
    transition: opacity var(--ui-transition-fast);
  }

  /* --- waterfall: dashed running-level connectors. --- */
  .aui-chart__wf-link {
    stroke: var(--ui-muted-foreground);
    stroke-width: 1;
    stroke-dasharray: 4 3;
  }

  /* --- heatmap: rounded cells + haloed in-cell values (cells range
     from pale to saturated, so foreground + background halo keeps the
     numbers readable on either end of the ramp). --- */
  .aui-chart__hm-cell {
    transition: opacity var(--ui-transition-fast);
  }

  .aui-chart__hm-cell:hover {
    opacity: 0.85;
  }

  /* --- funnel: centered stage trapezoids with haloed in-stage
     labels (stages span the palette, so foreground plus a
     background halo keeps the name/value readable on any stage). --- */
  .aui-chart__funnel-seg {
    transition: opacity var(--ui-transition-fast);
  }

  .aui-chart__funnel-seg:hover {
    opacity: 0.85;
  }

  .aui-chart__funnel-text text {
    fill: var(--ui-foreground);
    paint-order: stroke;
    stroke: var(--ui-background);
    stroke-width: 2.5px;
    stroke-linejoin: round;
    font-size: 13px;
    font-weight: var(--ui-font-semibold);
    font-family: var(--ui-font-sans);
    text-anchor: middle;
    pointer-events: none;
  }

  .aui-chart__funnel-value {
    font-size: 12px !important;
    font-weight: var(--ui-font-medium) !important;
  }

  /* --- waffle: unit cells with a hover fade. --- */
  .aui-chart__waffle-cell {
    transition: opacity var(--ui-transition-fast);
  }

  .aui-chart__waffle-cell:hover {
    opacity: 0.85;
  }

  /* --- bullet: thick measure bar over muted range bands, a
     foreground target tick, and plain row labels (rows sit on the
     background, so no halo is needed). --- */
  .aui-chart__bullet-bar {
    transition: opacity var(--ui-transition-fast);
  }

  .aui-chart__bullet-bar:hover {
    opacity: 0.85;
  }

  .aui-chart__bullet-target {
    fill: var(--ui-foreground);
  }

  .aui-chart__bullet-label {
    fill: var(--ui-foreground);
    font-size: 13px;
    font-family: var(--ui-font-sans);
  }

  /* --- dumbbell: muted delta connectors between Cleveland dots
     (dots reuse .aui-chart__dot for fill + background ring). --- */
  .aui-chart__db-link {
    stroke: var(--ui-muted-foreground);
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.6;
  }

  /* --- treemap: area-proportioned tiles with haloed top-left labels
     (tiles range across saturated palette colors, so foreground plus
     a background halo keeps the name/value readable on any tile). --- */
  .aui-chart__tm-tile {
    transition: opacity var(--ui-transition-fast);
  }

  .aui-chart__tm-tile:hover {
    opacity: 0.85;
  }

  .aui-chart__tm-name {
    fill: var(--ui-foreground);
    paint-order: stroke;
    stroke: var(--ui-background);
    stroke-width: 2.5px;
    stroke-linejoin: round;
    font-size: 15px;
    font-weight: var(--ui-font-semibold);
    font-family: var(--ui-font-sans);
    pointer-events: none;
  }

  .aui-chart__tm-value {
    fill: var(--ui-foreground);
    paint-order: stroke;
    stroke: var(--ui-background);
    stroke-width: 2.5px;
    stroke-linejoin: round;
    font-size: 13px;
    font-family: var(--ui-font-sans);
    pointer-events: none;
  }

  /* --- terrain: wireframe mesh + point field. Row opacity/dash and
     dot opacity ride inline styles (depth fade); the class supplies
     geometry and default colors only. --- */
  .aui-chart__terrain-wash {
    pointer-events: none;
  }

  .aui-chart__terrain-mesh path {
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.1;
  }

  .aui-chart__terrain-dots circle {
    stroke: none;
  }

  .aui-chart__terrain-ring {
    fill: var(--ui-background);
    stroke: currentcolor;
    stroke-width: 1.5;
  }

  .aui-chart__terrain-ring--extreme {
    stroke: var(--ui-foreground);
    stroke-width: 1.8;
  }

  .aui-chart__terrain-axis text {
    fill: var(--ui-muted-foreground);
    font-size: 12px;
    font-family: var(--ui-font-sans);
  }

  .aui-chart__terrain-callout path {
    stroke: var(--ui-muted-foreground);
    stroke-width: 1;
  }

  .aui-chart__terrain-callout text {
    fill: var(--ui-foreground);
    paint-order: stroke;
    stroke: var(--ui-background);
    stroke-width: 2.5px;
    stroke-linejoin: round;
    font-size: 11px;
    font-weight: var(--ui-font-semibold);
    font-family: var(--ui-font-sans);
  }

  .aui-chart__terrain-callout-title {
    letter-spacing: 0.08em;
    font-size: 10px !important;
    fill: var(--ui-muted-foreground) !important;
