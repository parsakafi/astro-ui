            {col}
          </text>
        ))}
        {cohort.rows.map((row, ri) => (
          <g>
            <text class="aui-chart__tick" x={cohort.padL - 10} y={(8 + ri * (cohort.ch + cohort.GAP) + cohort.ch / 2 + 4).toFixed(1)} text-anchor="end">
              {row}
            </text>
            {cohort.sizes[ri] != null && (
              <text class="aui-chart__cohort-size" x={cohort.padL - 10} y={(8 + ri * (cohort.ch + cohort.GAP) + cohort.ch / 2 + 18).toFixed(1)} text-anchor="end">
                {format(cohort.sizes[ri])} users
              </text>
            )}
          </g>
        ))}
      </svg>
