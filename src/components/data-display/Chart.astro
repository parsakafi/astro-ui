  {
    isTerrain && terrain && (
      <svg
        class="aui-chart__svg"
        viewBox={`0 0 ${W} ${height}`}
        role="img"
        aria-label={`${tableCaption}: ${terrain.rows.length} rows × ${terrain.cols.length} columns, elevations ${format(terrain.vMin)} to ${format(terrain.vMax)}`}
        preserveAspectRatio="xMidYMid meet"
      >
        <defs>
          <radialGradient id={`${uid}-twash`} cx="50%" cy="50%" r="50%">
            <stop offset="0%" style={`stop-color: ${colorAt(0, series[0])}; stop-opacity: 0.1`}/>
            <stop offset="100%" style={`stop-color: ${colorAt(0, series[0])}; stop-opacity: 0`}/>
          </radialGradient>
        </defs>
        <ellipse class="aui-chart__terrain-wash" cx={terrain.wash.cx} cy={terrain.wash.cy}
                 rx={terrain.wash.rx} ry={terrain.wash.ry} fill={`url(#${uid}-twash)`}/>
        {(terrainMode === "wire" || terrainMode === "both") && (
          <g class="aui-chart__terrain-mesh" style={`color: ${colorAt(0, series[0])}`}>
            {terrain.colPaths.map((p) => (
              <path d={p.d} style="opacity: 0.35"/>
            ))}
            {terrain.rowPaths.map((p) => (
              <path d={p.d} style={`opacity: ${(0.5 + p.front * 0.4).toFixed(2)}${p.front < 0.25 ? "; stroke-dasharray: 4 4" : ""}`}/>
            ))}
          </g>
        )}
        {(terrainMode === "dots" || terrainMode === "both") && (
          <g class="aui-chart__terrain-dots">
            {terrain.dots.map((p) => (
              <circle cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r={terrainMode === "dots" ? 1.7 : 1.4}
                      fill={terrainDotColors
                        ? p.v <= terrain.bandLo ? terrainDotColors[0] : p.v >= terrain.bandHi ? terrainDotColors[2] : terrainDotColors[1]
                        : p.v >= terrain.hotAt ? colorAt(0, series[0]) : "var(--ui-muted-foreground)"}
                      style={`opacity: ${(0.3 + (p.zi / (terrain.rows.length - 1)) * 0.5).toFixed(2)}`}>
                <title>{`${terrain.rows[p.zi]} — ${terrain.cols[p.xi]}: ${format(p.v)}`}</title>
              </circle>
            ))}
          </g>
        )}
        {/* Sample rings across the field + black rings on the extremes,
            joined by the range bracket with corner callouts. */}
        <g style={`color: ${colorAt(0, series[0])}`}>
          {terrain.rings.map((p) => (
            <circle class="aui-chart__terrain-ring" cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r={5}>
              <title>{`${terrain.rows[p.zi]} — ${terrain.cols[p.xi]}: ${format(p.v)}`}</title>
            </circle>
          ))}
        </g>
        {terrainCallouts && (
          <Fragment>
            <circle class="aui-chart__terrain-ring aui-chart__terrain-ring--extreme" cx={terrain.hiP.x} cy={terrain.hiP.y} r={6}/>
            <circle class="aui-chart__terrain-ring aui-chart__terrain-ring--extreme" cx={terrain.loP.x} cy={terrain.loP.y} r={6}/>
          </Fragment>
        )}
        {terrainCallouts && (
        <g class="aui-chart__terrain-callout">
          {/* Reference-style bracket: two rail stubs, each from its
              corner title to the drop above its extreme — no line
              runs between the two drops. */}
          <path d={`M ${PAD.left} ${terrain.railY} H ${terrain.hiP.x.toFixed(1)}`} fill="none"/>
          <path d={`M ${terrain.loP.x.toFixed(1)} ${terrain.railY} H ${W - 24}`} fill="none"/>
          <path d={`M ${terrain.hiP.x.toFixed(1)} ${terrain.railY} V ${(terrain.hiP.y - 8).toFixed(1)}`} fill="none"/>
          <path d={`M ${terrain.loP.x.toFixed(1)} ${terrain.railY} V ${(terrain.loP.y - 8).toFixed(1)}`} fill="none"/>
          <text class="aui-chart__terrain-callout-title" x={PAD.left} y={(terrain.railY - 22).toFixed(1)}>
            {terrainCalloutLabels[0]}
          </text>
          <text x={PAD.left} y={(terrain.railY - 8).toFixed(1)}>
            {format(terrain.hiP.v)}
          </text>
          <text class="aui-chart__terrain-callout-title" x={(W - 24).toFixed(1)} y={(terrain.railY - 22).toFixed(1)} text-anchor="end">
            {terrainCalloutLabels[1]}
          </text>
          <text x={(W - 24).toFixed(1)} y={(terrain.railY - 8).toFixed(1)} text-anchor="end">
            {format(terrain.loP.v)}
          </text>
        </g>
        )}
        {terrainAxes && (
          <g class="aui-chart__terrain-axis">
            <text x={PAD.left - 20} y={height - 8}>{terrainAxes[0]}</text>
            <text x={W / 2} y={height - 8} text-anchor="middle">{terrainAxes[1]}</text>
            <text x={W - 12} y={height - 8} text-anchor="end">{terrainAxes[2]}</text>
          </g>
        )}
      </svg>
    )
  }

  {
    isMap && map && (
      <svg
        class="aui-chart__svg"
        viewBox={`0 0 ${W} ${height}`}
        role="img"
        aria-label={`${tableCaption}: ${map.regions.length} regions, values ${format(map.vMin)} to ${format(map.vMax)}`}
        preserveAspectRatio="xMidYMid meet"
      >
        <defs>
          <filter id={`${uid}-mshadow`} x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="0" dy="3" stdDeviation="4" flood-color="rgb(0 0 0 / 0.18)"/>
          </filter>
        </defs>
        <g class="aui-chart__map-regions" filter={`url(#${uid}-mshadow)`}>
          {map.regions.map((r) =>
            r.d ? (
              <path class="aui-chart__map-region" d={r.d} fill={r.color} stroke="var(--ui-background)" stroke-width={3} stroke-linejoin="round">
                <title>{`${r.name}: ${format(r.v)}`}</title>
              </path>
            ) : (
              <rect class="aui-chart__map-region" x={r.rect!.x.toFixed(1)} y={r.rect!.y.toFixed(1)} width={r.rect!.w.toFixed(1)} height={r.rect!.h.toFixed(1)}
                    rx={2} fill={r.color} stroke="var(--ui-background)" stroke-width={3}>
                <title>{`${r.name}: ${format(r.v)}`}</title>
              </rect>
            ),
          )}
        </g>
        {mapLabels &&
          map.regions.map((r) => (
            <text class="aui-chart__hm-value" x={r.cx.toFixed(1)} y={(r.cy + 4).toFixed(1)} text-anchor="middle">
              {format(r.v)}
            </text>
          ))}
      </svg>
    )
  }

  {
    isBoxplot && boxData && (
      <svg
        class="aui-chart__svg"
        viewBox={`0 0 ${W} ${height}`}
        role="img"
        aria-label={`${tableCaption}: ${boxData.cats.join(", ")}`}
        preserveAspectRatio="xMidYMid meet"
      >
        <defs>
          <filter id={`${uid}-bshadow`} x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="rgb(0 0 0 / 0.14)"/>
          </filter>
        </defs>
        {grid && (
          <g class="aui-chart__grid" aria-hidden="true">
            {boxData.ticks.map((t) => (
              <line x1={PAD.left} x2={W - PAD.right} y1={boxData.by(t)} y2={boxData.by(t)}/>
            ))}
          </g>
        )}
        {grid &&
          boxData.ticks.map((t) => (
            <text class="aui-chart__tick" x={PAD.left - 6} y={boxData.by(t) + 3} text-anchor="end">
              {format(Math.round(t * 10) / 10)}
            </text>
          ))}
        {boxData.cats.map((cat, ci) => (
          <text
            class="aui-chart__tick"
            x={PAD.left + ci * boxData.slotW + boxData.slotW / 2}
            y={height - 8}
            text-anchor="middle"
          >
            {cat}
          </text>
        ))}
        {boxData.boxes.map((r) => (
          <g>
            <line class="aui-chart__whisker" x1={r.cx} x2={r.cx} y1={r.yMin} y2={r.yMax}/>
            <line class="aui-chart__whisker" x1={r.cx - boxData.capW / 2} x2={r.cx + boxData.capW / 2} y1={r.yMin} y2={r.yMin}/>
            <line class="aui-chart__whisker" x1={r.cx - boxData.capW / 2} x2={r.cx + boxData.capW / 2} y1={r.yMax} y2={r.yMax}/>
            <rect class="aui-chart__box" x={r.x} y={r.yQ3} width={r.w} height={Math.max(r.yQ1 - r.yQ3, 2)}
                  rx={Math.max(0, Math.min(boxRadius, r.w / 2))} fill={r.color} filter={`url(#${uid}-bshadow)`}>
              <title>{r.tip}</title>
            </rect>
            <line class="aui-chart__median" x1={r.x} x2={r.x + r.w} y1={r.yMed} y2={r.yMed}>
              <title>{r.tip}</title>
            </line>
            {boxplotOutliers &&
              r.outliers.map((o) => (
                <circle class="aui-chart__outlier" cx={r.cx} cy={o.y} r={3} fill={r.color}>
                  <title>{`${r.cat}${boxData.grouped ? ` — ${r.group}` : ""}: outlier ${format(o.v)}`}</title>
                </circle>
              ))}
          </g>
        ))}
      </svg>
    )
  }

  {
    isTreemap && treemap && (
      <svg
        class="aui-chart__svg"
        viewBox={`0 0 ${W} ${height}`}
        role="img"
        aria-label={`${tableCaption}: ${treemap.tiles.map((d) => `${d.label} ${d.pct}%`).join(", ")}`}
        preserveAspectRatio="xMidYMid meet"
      >
        {treemap.tiles.map((t) => (
          <g>
            <rect class="aui-chart__tm-tile" x={t.x} y={t.y} width={t.w} height={t.h}
                  rx={t.rx} fill={t.color}>
              <title>{t.tip}</title>
            </rect>
            {t.showName && (
              <text class="aui-chart__tm-name" x={t.x + 12} y={t.y + 24}>{t.label}</text>
            )}
            {t.showValue && (
              <text class="aui-chart__tm-value" x={t.x + 12} y={t.y + 44}>{t.valueText}</text>
            )}
          </g>
        ))}
      </svg>
    )
  }

  {
    isFunnel && funnel && (
      <svg
        class="aui-chart__svg"
        viewBox={`0 0 ${W} ${height}`}
        role="img"
        aria-label={`${tableCaption}: ${funnel.stages.map((s) => `${s.label} ${s.pct}%`).join(", ")}`}
        preserveAspectRatio="xMidYMid meet"
      >
        {funnel.stages.map((s) => (
          <g>
            <path class="aui-chart__funnel-seg" d={s.d} fill={s.color}>
              <title>{s.tip}</title>
            </path>
            {s.showText && (
              <g class="aui-chart__funnel-text">
                <text x={s.tx} y={s.ty - 2} text-anchor="middle">{s.name}</text>
                <text class="aui-chart__funnel-value" x={s.tx} y={s.ty + 16} text-anchor="middle">
                  {s.valueText}
                </text>
              </g>
            )}
          </g>
        ))}
      </svg>
    )
  }

  {
    isRose && rose && (
      <svg
        class="aui-chart__svg"
        viewBox={`0 0 ${W} ${height}`}
        role="img"
        aria-label={`${tableCaption}: ${rose.slices.map((d) => `${d.label} ${d.pct}%`).join(", ")}`}
        preserveAspectRatio="xMidYMid meet"
      >
        {rose.slices.map((d) => (
          <path class="aui-chart__slice" d={d.d} fill={d.color}>
            <title>{d.tip}</title>
          </path>
        ))}
        {(sliceLabels === "value" || sliceLabels === "value-pct") &&
          rose.slices.map((d) => (
            <text class="aui-chart__slice-value" x={d.lx} y={d.ly + 5} text-anchor="middle">
              {sliceLabelFormat
                ? sliceLabelFormat(d.value, d.pct)
                : sliceLabels === "value-pct"
                  ? `${format(d.value)} · ${d.pct}%`
                  : format(d.value)}
            </text>
          ))}
        {sliceLabels === "label" &&
          rose.slices.map((d) => (
            <g class="aui-chart__slice-label">
              <path d={d.leader}/>
              <text x={d.tx + d.dir * 2} y={d.by + 4} text-anchor={d.dir > 0 ? "start" : "end"}>
                {d.label}
              </text>
            </g>
          ))}
      </svg>
    )
  }

  {
    isHistogram && histogram && (
      <svg
        class="aui-chart__svg"
        viewBox={`0 0 ${W} ${height}`}
        role="img"
        aria-label={`${tableCaption}: ${histogram.n} samples in ${histogram.k} bins, ${format(histogram.lo)} to ${format(histogram.hi)}`}
        preserveAspectRatio="xMidYMid meet"
      >
        {grid && (
          <g class="aui-chart__grid" aria-hidden="true">
            {histogram.ticks.map((t) => (
              <line x1={PAD.left} x2={W - PAD.right} y1={histogram.yAt(t)} y2={histogram.yAt(t)}/>
            ))}
          </g>
        )}
        {grid &&
          histogram.ticks.map((t) => (
            <text class="aui-chart__tick" x={PAD.left - 6} y={histogram.yAt(t) + 3} text-anchor="end">
              {Math.round(t * 10) / 10}
            </text>
          ))}
        {histogram.bars.map((b) => (
          <rect class="aui-chart__bar" x={b.x} y={b.y} width={b.w} height={b.h}
                fill={colorAt(0, series[0])}>
            <title>{b.tip}</title>
          </rect>
        ))}
        {histogram.xticks.map((t, ti, arr) => (
          <text
            class="aui-chart__tick"
            x={t.x}
            y={height - 8}
            text-anchor={ti === 0 ? "start" : ti === arr.length - 1 ? "end" : "middle"}
          >
            {format(Math.round(t.e * 10) / 10)}
          </text>
        ))}
      </svg>
    )
  }

  {
    isWaffle && waffle && (
      <svg
        class="aui-chart__svg"
        viewBox={`0 0 ${W} ${height}`}
        role="img"
        aria-label={`${tableCaption}: ${waffle.groups.map((g) => `${g.label} ${g.pct}%`).join(", ")}`}
        preserveAspectRatio="xMidYMid meet"
      >
        {waffle.cells.map((c) => {
          const g = waffle.groups[c.gi];
          return (
            <rect class="aui-chart__waffle-cell"
                  x={(c.x + waffle.gap / 2).toFixed(1)} y={(c.y + waffle.gap / 2).toFixed(1)}
                  width={(waffle.cell - waffle.gap).toFixed(1)} height={(waffle.cell - waffle.gap).toFixed(1)}
                  rx={3} fill={g.color}>
              <title>{g.tip}</title>
            </rect>
          );
        })}
      </svg>
    )
  }

  {
    isBullet && bullet && (
      <svg
        class="aui-chart__svg"
        viewBox={`0 0 ${W} ${height}`}
        role="img"
        aria-label={`${tableCaption}: ${bullet.lanes.map((l) => `${l.label} ${format(l.measure)}${l.target != null ? ` (target ${format(l.target)})` : ""}`).join(", ")}`}
        preserveAspectRatio="xMidYMid meet"
      >
        {grid && (
          <g class="aui-chart__grid" aria-hidden="true">
            {bullet.ticks.map((t) => (
              <line x1={bullet.xAt(t)} x2={bullet.xAt(t)} y1={bullet.top} y2={height - 8}/>
            ))}
          </g>
        )}
        {grid &&
          bullet.ticks.map((t) => (
            <text class="aui-chart__tick" x={bullet.xAt(t)} y={bullet.top - 6} text-anchor="middle">
              {format(Math.round(t * 10) / 10)}
            </text>
          ))}
        {bullet.lanes.map((l) => (
          <g>
            {l.bands.map((b) => (
              <rect x={b.x} y={l.y} width={b.w} height={l.h} fill="var(--ui-muted-foreground)" fill-opacity={b.o}/>
            ))}
            <rect class="aui-chart__bullet-bar" x={bullet.xAt(0)} y={l.barY}
                  width={Math.max(bullet.xAt(l.measure) - bullet.xAt(0), 2)} height={10} rx={2} fill={l.color}>
              <title>{l.tip}</title>
            </rect>
            {l.target != null && (
              <rect class="aui-chart__bullet-target" x={bullet.xAt(l.target) - 1.5} y={l.y + 2} width={3} height={l.h - 4}>
                <title>{`${l.label}: target ${format(l.target)}`}</title>
              </rect>
