            <text class="aui-chart__bullet-label" x={96} y={l.y + l.h / 2 + 4} text-anchor="end">
              {l.label}
            </text>
            {l.valText.length * 6.5 < 36 && (
              <text class="aui-chart__tick" x={bullet.trackEnd + 6} y={l.y + l.h / 2 + 4} text-anchor="start">
                {l.valText}
              </text>
            )}
          </g>
        ))}
      </svg>
    )
  }

  {
    isDumbbell && dumbbell && (
      <svg
        class="aui-chart__svg"
        viewBox={`0 0 ${W} ${height}`}
        role="img"
        aria-label={`${tableCaption}: ${series.map((s) => s.name).join(", ")}`}
        preserveAspectRatio="xMidYMid meet"
      >
        {grid && (
          <g class="aui-chart__grid" aria-hidden="true">
            {dumbbell.ticks.map((t) => (
              <line x1={dumbbell.xAt(t)} x2={dumbbell.xAt(t)} y1={PAD.top} y2={PAD.top + plotH}/>
            ))}
          </g>
        )}
        {grid &&
          dumbbell.ticks.map((t) => (
            <text class="aui-chart__tick" x={dumbbell.xAt(t)} y={height - 8} text-anchor="middle">
              {format(Math.round(t * 10) / 10)}
