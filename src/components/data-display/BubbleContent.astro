---
/**
 * BubbleContent — the visible rounded box inside a Bubble.
 *
 * Purely presentational div carrying the bubble look (variant colors
 * resolve from the Bubble root). Compose text, lists, code — anything.
 * The Bubble root gives a <button>/<a> content an interactive hover.
 *
 *   <Bubble align="end">
 *     <BubbleContent>Hello!</BubbleContent>
 *   </Bubble>
 *
 * JavaScript required: No
 */
import { cn } from "../../utils/cn";

export interface Props {
  class?: string;
  id?: string;
  /** Accessible name when the content is interactive or unlabeled. */
  ariaLabel?: string;
}

const { class: className, id, ariaLabel, ...rest } = Astro.props;

const classes = cn("aui-bubble__content", className);
---

<div id={id} class={classes} aria-label={ariaLabel} {...rest}>
  <slot/>
</div>

<style>
  /* Structural only — the look (colors, radius, type) lives in the
     Bubble root so variant context stays in one place. */
  .aui-bubble__content {
    min-inline-size: 0;
    font-family: var(--ui-font-sans);
  }
</style>
