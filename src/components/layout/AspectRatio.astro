---
/**
 * AspectRatio — reserves a fixed width/height ratio for media.
 *
 * Pure CSS: the wrapper gets `aspect-ratio` and the (single) child is
 * stretched to fill it. Drop in an
 * <img>, <video>, or map and it covers the box without layout shift.
 *
 *   <AspectRatio ratio="16 / 9">
 *     <img src="hero.jpg" alt="Hero" />
 *   </AspectRatio>
 *
 * JavaScript required: No
 */
import { cn } from "../../utils/cn";

export interface Props {
  /** CSS aspect-ratio value: number (1.78) or string ("16 / 9"). */
  ratio?: number | string;
  class?: string;
  id?: string;
}

const { ratio = 1, class: className, id, ...rest } = Astro.props;

const classes = cn("aui-aspect-ratio", className);
---

<div id={id} class={classes} style={{aspectRatio: String(ratio)}} {...rest}>
  <slot/>
</div>

<style>
  .aui-aspect-ratio {
    position: relative;
    width: 100%;
    overflow: hidden;
    font-family: var(--ui-font-sans);
  }

  /* Single child (img/video/iframe/div) fills the box, object-fit
     stays in consumer hands. :global() because slotted children carry
     no scope attribute. */
  .aui-aspect-ratio > :global(*) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>
